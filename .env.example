# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ilerihub"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Azure AD - Microsoft Graph Calendar API
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Microsoft Graph
GRAPH_API_ENDPOINT="https://graph.microsoft.com/v1.0"

# SMTP Email Settings (Office 365)
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ILERIHub <noreply@example.com>"

# Bildirim test-modu (YALNIZ staging/test — PROD'DA SET ETME).
# NOTIFY_TEST_MODE="true" iken: TÜM mailler NOTIFY_TEST_EMAIL'e yönlendirilir
# (konu "[TEST → gerçek alıcı: X]"), PUSH tamamen kapalıdır. Boş/absent = normal gönderim.
NOTIFY_TEST_MODE=""
NOTIFY_TEST_EMAIL=""

# Toplu Kart Okutamama — "İK'ya Bildir" bildirim maili alıcısı.
# Boş/absent iken bildirim maili ATILMAZ (log uyarısı düşülür, akış hatasız döner).
KART_OKUTAMAMA_HR_EMAIL=""

# Envanter kritik stok bildirimi alıcısı (virgülle çoklu adres desteklenir).
# Önerilen değer: insan.varliklari@ilerigroup.com
# Boş/absent iken bildirim maili GÖNDERİLMEZ (route 400 "alıcı tanımlanmamış" döner).
# Staging'de MAIL_RECIPIENT_OVERRIDE/NOTIFY_TEST_MODE guard'ı sendEmail içinde geçerlidir.
ENVANTER_KRITIK_BILDIRIM_ALICI=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# On-Premise LDAP / Active Directory
LDAP_URL="ldap://localhost:389"
LDAP_BASE_DN="DC=example,DC=com"
LDAP_USERS_DN="DC=example,DC=com"
LDAP_BIND_DN=""
LDAP_BIND_PASSWORD=""

# Push Notifications (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:admin@example.com"

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ACME cert expire monitor (PR-ACME-MONITOR)
# Virgülle ayrılmış email listesi — cert expire alert'i bu adreslere gider
ACME_ALERT_EMAILS="admin@example.com"
# Virgülle ayrılmış domain listesi — TLS handshake ile cert kontrol edilir
ACME_MONITOR_DOMAINS="hub.ilerigroup.com,staging.hub.ilerigroup.com"
# Eşik gün listesi — bu eşiklerin altına düştüğünde alert tetiklenir (idempotent)
ACME_ALERT_THRESHOLDS="30,14,7,1"

# IFS Cloud Entegrasyonu (ShopFloorService — Premium API), server-only
# ShopFloorService.svc projection base URL'i (sondaki slash opsiyonel)
IFS_INT_BASE_URL="https://ifscloudtest.example.com/int/ifsapplications/projection/v1/ShopFloorService.svc"
# entity/v1 gateway kökü (barkod üretimi — InventoryPartBarcodeEntity). Boşsa IFS_INT_BASE_URL'den türetilir.
IFS_ENTITY_BASE_URL="https://ifscloudtest.example.com/int/ifsapplications/entity/v1"
# OAuth2 client_credentials token endpoint (Keycloak)
IFS_TOKEN_URL=""
IFS_CLIENT_ID=""
IFS_CLIENT_SECRET=""
# Opsiyonel OAuth2 scope (gerekmiyorsa boş bırak)
IFS_SCOPE=""
# IFS site/contract kodu (varsayılan: ILER2)
IFS_CONTRACT="ILER2"

# === Syteline (MSSQL) → IFS malzeme senkronu (feat/syteline-part-sync) ===
SYTELINE_HOST=
SYTELINE_PORT=1433
SYTELINE_DB=
SYTELINE_USER=
SYTELINE_PASS=
# Opsiyonel: yalnız bu site_ref'i senkronla (boş = tüm siteler)
SYTELINE_SITE=
# TLS (self-signed sunucu için trust; varsayılan her ikisi de true)
SYTELINE_ENCRYPT=true
SYTELINE_TRUST_CERT=true
# Bir çalışmada IFS'e yazılacak azami kayıt
SYTE_SYNC_BATCH=50


# ── İşe alım Faz 1: "Adaya Geri Gönder" kill-switch ──────────────────────────
# VARSAYILAN KAPALI. ADAYA_GERI_GONDERILDI yeni bir enum degeri; blue-green'de deploy
# sonrasi PASIF slot hala eski Prisma client ile calisir ve bu degeri TANIMAZ. Rollback
# penceresinde bu statuye kayit dusmusse eski slot o kaydi okurken patlar.
# Kapaliyken: hedef allowedTargets'ta gorunmez + transition ucu 403 doner.
# Pencere kapandiktan sonra 'true' yapilir — yalniz uygulama restart'i yeter, migration YOK.
# Kod: src/lib/recruitment/adaya-geri-gonder.ts
RECRUITMENT_ADAYA_GERI_GONDER_ENABLED="false"

# ── İşe alım Faz 4: teknik mülakat 2. kademe kill-switch ─────────────────────
# VARSAYILAN KAPALI. TEKNIK_MULAKAT_UST_ONAY yeni bir enum degeri; blue-green'de deploy
# sonrasi PASIF slot eski Prisma client ile calisir ve bu degeri TANIMAZ. Rollback
# penceresinde bu statuye kayit dusmusse eski slot bozulur.
# Kapaliyken: hedef allowedTargets'ta gorunmez + transition ucu 403 doner.
# Pencere kapandiktan sonra 'true' yapilir — uygulama restart'i yeter, migration YOK.
# Kod: src/lib/recruitment/teknik-mulakat-bayrak.ts
RECRUITMENT_TEKNIK_MULAKAT_2KADEME_ENABLED="false"

# ── İşe alım Faz 6: Personele Dönüştür kill-switch ───────────────────────────
# VARSAYILAN KAPALI. EVRAK_HAZIRLIK yeni bir enum degeri; blue-green'de deploy sonrasi
# PASIF slot eski Prisma client ile calisir ve bu degeri TANIMAZ. Rollback penceresinde
# bu statuye kayit dusmusse eski slot bozulur.
# Kapaliyken: EVRAK_HAZIRLIK hedefi allowedTargets'ta gorunmez, transition ucu 403 doner
# ve donusum ucunun (GET+POST) TAMAMI 403 verir.
# NOT: bayrak kapaliyken ISE_BASLADI'ya HIC gecilemez (tek yol donusum formu). Pencere
# kapaninca 'true' yapilir — uygulama restart'i yeter, migration YOK.
# Kod: src/lib/recruitment/personele-donustur-bayrak.ts
RECRUITMENT_PERSONELE_DONUSTUR_ENABLED="false"

# ── IV-FR-27 deneme degerlendirme bildirimleri (Faz 3) ──
# KAPALIYKEN: cron form ACAR (veri birikir, zincir dogrulanir) ama mail/in-app
# bildirim GITMEZ, eskalasyon calismaz, hatirlatmaSeviyesi degismez.
# Gerekce: Faz 3 canliya cikti, Faz 4 (ekranlar) henuz yok — maildeki baglantinin
# acacagi ekran olmadan bildirim gonderilmemeli. Faz 4 bitince 'true' yapilir,
# uygulama restart'i yeter, migration YOK.
# KAPSAM: yalniz IV-FR-27. check-evaluations'in mevcut IV maili (TWO_MONTH/SIX_MONTH)
# ve belge takibi bu bayraktan ETKILENMEZ.
# Kod: src/lib/deneme/deneme-bayrak.ts
DENEME_BILDIRIM_ENABLED="false"

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ilerihub"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Azure AD - Microsoft Graph Calendar API
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Microsoft Graph
GRAPH_API_ENDPOINT="https://graph.microsoft.com/v1.0"

# SMTP Email Settings (Office 365)
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ILERIHub <noreply@example.com>"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# On-Premise LDAP / Active Directory
LDAP_URL="ldap://localhost:389"
LDAP_BASE_DN="DC=example,DC=com"
LDAP_USERS_DN="DC=example,DC=com"
LDAP_BIND_DN=""
LDAP_BIND_PASSWORD=""

# Push Notifications (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:admin@example.com"

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

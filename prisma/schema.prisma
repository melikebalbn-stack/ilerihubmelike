// Denetim Ekibi
model QdmsAuditTeamMember {
  id      String    @id @default(cuid())
  auditId String
  audit   QdmsAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])
  role   String // Rol (Denetçi, Gözlemci, vb.)

  @@unique([auditId, userId])
  @@index([auditId])
}

// Denetim Kontrol Listesi
model QdmsAuditChecklist {
  id      String    @id @default(cuid())
  auditId String
  audit   QdmsAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  clauseNumber String? // Madde no
  question     String  @db.Text // Soru
  requirement  String? @db.Text // Gereklilik

  // Değerlendirme
  response String? // Cevap (Uygun, Uygun Değil, N/A)
  evidence String? @db.Text // Kanıt
  notes    String? @db.Text // Notlar

  order Int @default(0) // Sıra

  @@index([auditId])
}

// Denetim Bulguları
model QdmsAuditFinding {
  id      String    @id @default(cuid())
  auditId String
  audit   QdmsAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  // Bulgu Detayı
  findingNumber   String // Bulgu no
  type            String // Bulgu türü (Majör, Minör, Gözlem, İyileştirme Fırsatı)
  clauseReference String? // İlgili madde
  description     String  @db.Text // Bulgu açıklaması
  evidence        String? @db.Text // Objektif kanıt

  // CAPA
  capaRequired Boolean   @default(false)
  capaId       String?
  capa         QdmsCapa? @relation(fields: [capaId], references: [id])

  // İlgili Dokümanlar
  documents QdmsDocument[] @relation("AuditFindingDocuments")

  // Durum
  status   QdmsCapaStatus @default(OPEN)
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auditId])
  @@index([type])
  @@index([status])
}

// =============================================================================
// RİSK YÖNETİMİ
// =============================================================================

model QdmsRisk {
  id String @id @default(cuid())

  // Risk Kimliği
  riskNumber  String @unique // Risk No
  title       String
  description String @db.Text

  // Sınıflandırma
  category String? // Risk kategorisi
  source   String? // Risk kaynağı

  // Departman
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Risk Değerlendirmesi
  likelihood Int // Olasılık (1-5)
  impact     Int // Etki (1-5)
  riskScore  Int // Risk Skoru (L x I)
  riskLevel  QdmsRiskLevel // Risk Seviyesi

  // Mevcut Kontroller
  currentControls String? @db.Text // Mevcut kontrol önlemleri

  // Aksiyon Planı
  mitigationPlan String?   @db.Text // Risk azaltma planı
  responsibleId  String?
  responsible    User?     @relation(fields: [responsibleId], references: [id])
  targetDate     DateTime?

  // Kalan Risk
  residualLikelihood Int? // Kalan olasılık
  residualImpact     Int? // Kalan etki
  residualRiskScore  Int? // Kalan risk skoru
  residualRiskLevel  QdmsRiskLevel?

  // Durum
  status     String    @default("OPEN") // OPEN, MITIGATED, ACCEPTED, CLOSED
  reviewDate DateTime? // Sonraki gözden geçirme

  createdById String
  createdBy   User   @relation("RiskCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([riskNumber])
  @@index([riskLevel])
  @@index([status])
  @@index([departmentId])
}

// =============================================================================
// TEDARİKÇİ YÖNETİMİ

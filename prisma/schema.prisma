  complaintNumber String @unique // Şikayet No

  // Müşteri Bilgisi
  customerName    String
  customerContact String?
  customerEmail   String?
  customerPhone   String?

  // Şikayet Detayı
  title       String
  description String  @db.Text
  productId   String?
  batchNumber String?

  // Sınıflandırma
  category String? // Şikayet kategorisi
  priority QdmsCapaPriority

  // Alındı
  receivedAt   DateTime
  receivedById String
  receivedBy   User     @relation("ComplaintReceiver", fields: [receivedById], references: [id])
  source       String? // Kaynak (Email, Phone, Web, vb.)


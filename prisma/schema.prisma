// =====================================================
// PUBLIC İŞ BAŞVURU FORMU
// =====================================================

model PublicJobApplication {
  id                    String   @id @default(cuid())
  applicationNumber     String   @unique @default(cuid()) // Başvuru numarası

  // Kişisel Bilgiler
  fullName              String   // Ad Soyad
  birthPlace            String?  // Doğum Yeri
  birthDate             DateTime? // Doğum Tarihi
  nationality           String?  // Uyruk
  tcKimlikNo            String?  // T.C. Kimlik No
  gender                Gender?  // Cinsiyet
  bloodType             BloodType? // Kan Grubu

  // Askerlik Durumu
  militaryStatus        MilitaryStatus? // Askerlik Durumu
  militaryPostponeDate  DateTime? // Tecil Tarihi

  // Medeni Durum
  maritalStatus         MaritalStatus? // Medeni Durum
  numberOfChildren      Int?     @default(0) // Çocuk Sayısı

  // Eş Bilgileri
  spouseWorking         Boolean? // Eşiniz Çalışıyor mu?
  spouseOccupation      String?  // Eşin Mesleği

  // Adres ve İletişim
  homeAddress           String?  @db.Text // Ev Adresi
  dependents            String?  @db.Text // Bakmakla Yükümlü Olduğunuz Kişiler
  mobilePhone           String?  // GSM
  workPhone             String?  // İş Telefonu
  homePhone             String?  // Ev Telefonu
  email                 String?  // E-mail

  // Bize Nasıl Ulaştınız
  referralSource        ReferralSource? // Bize Nasıl Ulaştınız
  referralSourceOther   String?  // Diğer (açıklama)

  // Üyelikler
  memberships           String?  @db.Text // Dernek/Kulüp/Sendika Üyelikleri

  // Sürücü Belgesi
  hasDriverLicense      Boolean? // Sürücü Belgesi Var mı?
  driverLicenseClass    String?  // Sürücü Belgesi Sınıfı
  driverLicenseDate     DateTime? // Sürücü Belgesi Tarihi

  // Fotoğraf
  photoUrl              String?  // Fotoğraf URL

  // Adli Sicil ve Hukuki Durum
  hasCriminalRecord     Boolean? // Adli Sicil Kaydınız Var mı?
  hasConviction         Boolean? // Hiç Hüküm Giydiniz mi?
  convictionDetails     String?  @db.Text // Dava Konusu
  hasOngoingCase        Boolean? // Devam Eden Mahkemeniz Var mı?

  // Fiziksel Özellikler
  height                Int?     // Boy (cm)
  weight                Int?     // Kilo (kg)
  shoeSize              String?  // Ayakkabı Numarası
  clothingSizeUpper     String?  // Üst Beden
  clothingSizeLower     String?  // Alt Beden

  // Çalışma Koşulları
  hasTravelRestriction  Boolean? // Seyahat Engeliniz Var mı?
  canWorkShifts         Boolean? // Vardiyalı ve Mesaili Çalışabilir misiniz?

  // Hobiler
  hobbies               String?  @db.Text // Hobileriniz

  // İş Tercihleri
  availableStartDate    DateTime? // İşe başlayabileceği en yakın tarih
  expectedSalary        Int?     // Talep edilen aylık brüt ücret (TL)
  requestedPosition     String?  // Talep edilen iş/bölüm
  previouslyWorkedHere  Boolean? // Daha önce İleri Grup'ta çalıştı mı?

  // Öğrenim Durumu
  educationLevel        EducationLevel? // En yüksek öğrenim durumu

  // Eğitim Bilgileri (JSON olarak)
  educationHistory      Json?    // Eğitim geçmişi detayları

  // Staj, Kurs ve Seminerler (JSON olarak)
  coursesAndSeminars    Json?    // Kurslar ve seminerler [{institution, subject, duration, attendanceDate}]

  // Yabancı Dil Bilgisi (JSON olarak)
  foreignLanguages      Json?    // Yabancı diller [{language, reading, writing, speaking, learnedAt}]

  // Bilgisayar Bilgisi (JSON olarak)
  computerSkills        Json?    // Bilgisayar programları [{program, level, learnedAt}]

  // İş Tecrübeleri (JSON olarak)
  workExperience        Json?    // İş tecrübeleri [{company, position, startDate, endDate, leavingReason, lastSalary}]

  // Firma bünyesinde akraba/tanıdık
  hasRelativesInCompany Boolean? // Firma bünyesinde akraba veya tanıdık var mı?
  relativeName          String?  // Akraba/tanıdık adı soyadı

  // İletişim Tercihi
  preferredContactGsm   Boolean? // GSM ile ulaşılabilir mi?
  preferredContactEmail Boolean? // E-posta ile ulaşılabilir mi?
  preferredContactOther String?  // Diğer iletişim yöntemi

  // Son işveren ile temasa geçilebilir mi?
  canContactLastEmployer Boolean? // Son iş yerinizle temasa geçebilir miyiz?

  // Referanslar (JSON olarak)
  references            Json?    // Referanslar [{name, company, position, phone}]

  // Beyan
  declarationAccepted   Boolean? // Beyan kabul edildi mi?
  declarationDate       DateTime? // Beyan tarihi

  // Dijital İmza
  digitalSignature      String?  // Dijital imza verisi (isim|tarih|timestamp)
  signatureDate         String?  // İmza tarihi (görüntülenen format)

  // Meta Bilgiler
  ipAddress             String?  // Başvuran IP adresi
  userAgent             String?  @db.Text // Tarayıcı bilgisi
  status                JobApplicationStatus @default(PENDING)
  notes                 String?  @db.Text // İK Notları

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([applicationNumber])
}

enum Gender {
  MALE    // Bay
  FEMALE  // Bayan
}

enum BloodType {
  A_POSITIVE   // A Rh+
  A_NEGATIVE   // A Rh-
  B_POSITIVE   // B Rh+
  B_NEGATIVE   // B Rh-
  AB_POSITIVE  // AB Rh+
  AB_NEGATIVE  // AB Rh-
  O_POSITIVE   // 0 Rh+
  O_NEGATIVE   // 0 Rh-
}

enum MilitaryStatus {

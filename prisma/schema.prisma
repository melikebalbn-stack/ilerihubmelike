// =============================================================================
// İÇ DENETİM YÖNETİMİ
// =============================================================================

model QdmsAudit {
  id              String   @id @default(cuid())
  
  // Denetim Kimliği
  auditNumber     String   @unique          // Denetim No
  title           String
  description     String?  @db.Text
  
  // Sınıflandırma
  type            QdmsAuditType
  standard        String?                   // Denetim standardı (ISO 9001, 14001, vb.)
  scope           String?  @db.Text         // Denetim kapsamı
  
  // Planlama
  plannedDate     DateTime                  // Planlanan tarih
  actualDate      DateTime?                 // Gerçekleşen tarih
  duration        Int?                      // Süre (saat)
  
  // Denetlenen
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  auditeeId       String?                   // Denetlenen kişi
  auditee         User?    @relation("Auditee", fields: [auditeeId], references: [id])
  
  // Denetim Ekibi
  leadAuditorId   String                    // Baş Denetçi
  leadAuditor     User     @relation("LeadAuditor", fields: [leadAuditorId], references: [id])
  
  // Durum
  status          QdmsAuditStatus @default(PLANNED)
  
  // Sonuç

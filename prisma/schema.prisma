// ILERIHub - Prisma Schema
// İleri Group Kurumsal Portal

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// NextAuth tabloları
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  azureAdId     String?   @unique
  email         String    @unique
  emailVerified DateTime?
  name          String?
  firstName     String?
  lastName      String?
  image         String?

  // Azure AD fields
  department    String?
  jobTitle      String?
  officeLocation String?
  mobilePhone   String?

  // ILERIHub fields
  role          Role      @default(EMPLOYEE)
  isActive      Boolean   @default(true)
  managerId     String?
  manager       User?     @relation("ManagerEmployees", fields: [managerId], references: [id])
  employees     User[]    @relation("ManagerEmployees")

  // Relations
  accounts      Account[]
  sessions      Session[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  responsibleDevices CalibrationDevice[] @relation("ResponsibleDevices")
  emailLogs     CalibrationEmailLog[]

  // QDMS Relations
  qdmsDocumentsOwned      QdmsDocument[] @relation("DocumentOwner")
  qdmsDocumentsCreated    QdmsDocument[] @relation("DocumentCreator")
  qdmsDocumentRevisions   QdmsDocumentRevision[]
  qdmsDocumentApprovals   QdmsDocumentApproval[]
  qdmsDocumentDistributions QdmsDocumentDistribution[]
  qdmsCapasInitiated      QdmsCapa[] @relation("CapaInitiator")
  qdmsCapasResponsible    QdmsCapa[] @relation("CapaResponsible")
  qdmsCapasVerified       QdmsCapa[] @relation("CapaVerifier")
  qdmsCapaActions         QdmsCapaAction[]
  qdmsNcrsDetected        QdmsNonConformance[] @relation("NCRDetector")
  qdmsNcrsDisposition     QdmsNonConformance[] @relation("NCRDisposition")
  qdmsNcrsClosed          QdmsNonConformance[] @relation("NCRCloser")
  qdmsAuditsAsAuditee     QdmsAudit[] @relation("Auditee")
  qdmsAuditsAsLeadAuditor QdmsAudit[] @relation("LeadAuditor")
  qdmsAuditTeamMembers    QdmsAuditTeamMember[]
  qdmsRisksCreated        QdmsRisk[] @relation("RiskCreator")
  qdmsRisksResponsible    QdmsRisk[]
  qdmsSupplierEvaluations QdmsSupplierEvaluation[]
  qdmsChangeRequests      QdmsChangeRequest[] @relation("ChangeRequester")
  qdmsChangesImplemented  QdmsChangeRequest[] @relation("ChangeImplementer")
  qdmsChangesVerified     QdmsChangeRequest[] @relation("ChangeVerifier")
  qdmsChangeApprovals     QdmsChangeRequestApproval[]
  qdmsTrainingRecords     QdmsTrainingRecord[]
  qdmsTrainingsGiven      QdmsTrainingRecord[] @relation("Trainer")
  qdmsComplaintsReceived  QdmsCustomerComplaint[] @relation("ComplaintReceiver")
  qdmsComplaintsResponsible QdmsCustomerComplaint[] @relation("ComplaintResponsible")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ILERIHub tabloları
enum Role {
  SUPER_ADMIN
  ADMIN
  HR_MANAGER
  QUALITY_MANAGER
  IT_MANAGER
  DEPT_HEAD
  SUPERVISOR
  EMPLOYEE
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique  // ILERIHub'da görünecek isim (örn: "Mühendislik")
  code      String   @unique
  adOuName  String?  @unique  // AD'deki OU adı (örn: "Muhendislik")
  adOuDn    String?           // AD'deki tam DN (örn: "OU=Muhendislik,OU=ilerigroup,DC=ilerigroup,DC=com")
  managerId String?
  parentId  String?
  parent    Department? @relation("SubDepartments", fields: [parentId], references: [id])
  children  Department[] @relation("SubDepartments")
  devices   CalibrationDevice[] @relation("DepartmentDevices")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // QDMS Relations
  qdmsDocuments           QdmsDocument[]
  qdmsDocumentDistributions QdmsDocumentDistribution[]
  qdmsCapas               QdmsCapa[]
  qdmsNonConformances     QdmsNonConformance[]
  qdmsAudits              QdmsAudit[]
  qdmsRisks               QdmsRisk[]
  qdmsChangeRequests      QdmsChangeRequest[]
  qdmsCustomerComplaints  QdmsCustomerComplaint[]

  @@index([isActive, sortOrder])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  type      NotificationType @default(INFO)
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// Push Notification Subscriptions
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  category  String
  updatedAt DateTime @updatedAt
}

// Kalibrasyon Ayarları - Dropdown Verileri
model CalibrationLocation {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model CalibrationDeviceType {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model CalibrationDeviceModel {
  id           String   @id @default(cuid())
  name         String   @unique
  manufacturer String?
  code         String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([manufacturer])
}

model CalibrationDeviceName {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model CalibrationDepartment {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// Kalibrasyon Modülü
model CalibrationDevice {
  id                String   @id @default(cuid())
  deviceId          String   @unique // CAL001, CAL002 gibi
  name              String
  type              String   // Ölçüm Cihazı, Test Ekipmanı, vb.
  calibrationType   String?  // Kalibrasyon, Doğrulama, Kal/Doğ
  manufacturer      String?
  model             String?
  serialNumber      String?
  location          String?
  department        String?
  responsiblePerson String?
  responsiblePersonEmail String? // AD'den seçilen kişinin email adresi

  // Sorumlu kullanıcılar (yeni)
  responsibleUserId String?
  responsibleUser   User?    @relation("ResponsibleDevices", fields: [responsibleUserId], references: [id])
  departmentId      String?
  assignedDept      Department? @relation("DepartmentDevices", fields: [departmentId], references: [id])

  // Kalibrasyon bilgileri
  calibrationInterval Int     // Gün cinsinden
  lastCalibrationDate DateTime
  nextCalibrationDate DateTime
  certificateNumber   String?

  // Durum
  status            CalibrationStatus @default(VALID)
  isActive          Boolean           @default(true)
  requiresResponsible Boolean         @default(false) // Zorunlu zimmet
  notes             String?           @db.Text

  // Dosya ekleri
  attachments       String?           @db.Text // JSON array of file URLs
  imageUrl          String?           // Ana görsel

  // İlişkiler
  calibrationHistory CalibrationHistory[]
  emailLogs         CalibrationEmailLog[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([nextCalibrationDate])
}

enum CalibrationStatus {
  VALID       // Geçerli
  EXPIRING    // Süresi dolmak üzere (30 gün içinde)
  EXPIRED     // Süresi dolmuş
  IN_PROCESS  // Kalibrasyonda
  OUT_OF_ORDER // Arızalı
}

model CalibrationHistory {
  id                String   @id @default(cuid())
  deviceId          String
  device            CalibrationDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  calibrationDate   DateTime
  nextDueDate       DateTime
  certificateNumber String?
  calibratedBy      String   // Kalibrasyon yapan firma/kişi
  cost              Float?
  result            CalibrationResult @default(PASS)
  notes             String?  @db.Text

  // Dosya ekleri
  certificatePath   String?
  attachments       String?  @db.Text // JSON array of file paths

  createdBy         String?
  createdAt         DateTime @default(now())

  @@index([deviceId])
  @@index([calibrationDate])
}

enum CalibrationResult {
  PASS      // Başarılı
  FAIL      // Başarısız
  CONDITIONAL // Şartlı
}

// Email Bildirim Sistemi
model CalibrationEmailLog {
  id          String   @id @default(cuid())
  deviceId    String
  device      CalibrationDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  recipientId String?
  recipient   User?    @relation(fields: [recipientId], references: [id])
  recipientEmails String? @db.Text // Virgülle ayrılmış e-posta adresleri (batch gönderimler için)

  emailType   CalibrationEmailType
  subject     String
  body        String   @db.Text
  sentAt      DateTime @default(now())
  status      EmailStatus @default(PENDING)
  errorMessage String? @db.Text

  @@index([deviceId])
  @@index([recipientId])
  @@index([sentAt])
}

enum CalibrationEmailType {
  EXPIRING_SOON    // 30 gün kala
  EXPIRED          // Süre doldu
  REMINDER         // Hatırlatma (7 gün sonra tekrar)
  COMPLETED        // Kalibrasyon tamamlandı
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

// Kalibrasyon Bildirim E-posta Adresleri
model CalibrationNotificationEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?  // Opsiyonel isim
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Kalibrasyon Bildirim Kuralları
model CalibrationNotificationRule {
  id            String                    @id @default(cuid())
  type          NotificationRuleType      // EXPIRING veya EXPIRED
  period        NotificationRulePeriod    // BEFORE veya AFTER
  days          Int                       // Gün sayısı (1-30)
  repeatWeekly  Boolean                   @default(false) // Haftalık tekrar
  isActive      Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([isActive])
  @@index([type])
}

enum NotificationRuleType {
  EXPIRING  // Süresi Yaklaşan
  EXPIRED   // Süresi Dolan
}

enum NotificationRulePeriod {
  BEFORE    // Kala
  AFTER     // Sonra
}

// ==========================================
// Planlı Görevler Modülü
// ==========================================

// Görev Kategorileri
model TaskCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?  // Renk kodu (örn: #3b82f6)
  icon        String?  // İkon adı
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       PlannedTask[]

  @@index([isActive, sortOrder])
}

// Planlı Görevler
model PlannedTask {
  id                String      @id @default(cuid())
  title             String
  description       String?     @db.Text

  // Kategori
  categoryId        String?
  category          TaskCategory? @relation(fields: [categoryId], references: [id])

  // Tarihler
  dueDate           DateTime    // Bitiş tarihi
  startDate         DateTime?   // Başlangıç tarihi (opsiyonel)
  completedDate     DateTime?   // Tamamlanma tarihi

  // Tekrarlama
  isRecurring       Boolean     @default(false)
  recurrenceType    RecurrenceType? // Tekrar tipi
  recurrenceInterval Int?       // Tekrar aralığı (kaç günde/haftada/ayda bir)

  // Hatırlatma
  reminderDays      Int[]       // Kaç gün önce hatırlatılsın (örn: [30, 7, 1])

  // Sorumlu kişi (AD'den) - Eski alanlar (geriye uyumluluk için)
  responsiblePerson String?
  responsiblePersonEmail String?

  // Sorumlu departman (AD'den) - Eski alan (geriye uyumluluk için)
  responsibleDepartment String?

  // Çoklu sorumlu kişiler (JSON: [{name, email}])
  responsiblePersons    String?     @db.Text // JSON array: [{name: string, email: string}]

  // Çoklu sorumlu departmanlar
  responsibleDepartments String[]   @default([])

  // Bildirim e-postaları (çoklu)
  notificationEmails    String[]  @default([])

  // Durum ve öncelik
  status            TaskStatus  @default(PENDING)
  priority          TaskPriority @default(NORMAL)

  // Ek bilgiler
  notes             String?     @db.Text
  attachments       String?     @db.Text // JSON array

  // Eskalasyon bilgileri
  escalationEnabled   Boolean     @default(false)  // Eskalasyon aktif mi?
  escalationCategory  EscalationCategory?  // Eskalasyon kategorisi
  escalationPriority  EscalationPriority?  // Eskalasyon seviyesi (1-4)
  escalationLevel   Int         @default(0)  // 0: yok, 1: yönetici, 2: üst yönetim (otomatik hesaplanan)
  escalatedAt       DateTime?   // Son eskalasyon tarihi
  managerNotifiedAt DateTime?   // Yöneticiye bildirim gönderildi mi?
  executiveNotifiedAt DateTime? // Üst yönetime bildirim gönderildi mi?

  // Metadata
  isActive          Boolean     @default(true)
  createdBy         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Parent-Child İlişkisi (tekrarlayan görevler için)
  parentTaskId      String?
  parentTask        PlannedTask?  @relation("TaskRecurrence", fields: [parentTaskId], references: [id])
  childTasks        PlannedTask[] @relation("TaskRecurrence")

  // İlişkiler
  emailLogs         TaskEmailLog[]
  fiveSFinding      FiveSFinding?   // 5S uygunsuzluğundan gelen görev

  @@index([status])
  @@index([parentTaskId])
  @@index([dueDate])
  @@index([categoryId])
  @@index([priority])
}

enum TaskStatus {
  PENDING      // Bekliyor
  IN_PROGRESS  // Devam Ediyor
  COMPLETED    // Tamamlandı
  CANCELLED    // İptal Edildi
  OVERDUE      // Gecikmiş
}

enum TaskPriority {
  LOW          // Düşük
  NORMAL       // Normal
  HIGH         // Yüksek
  CRITICAL     // Kritik
}

enum RecurrenceType {
  DAILY        // Günlük
  WEEKLY       // Haftalık
  MONTHLY      // Aylık
  QUARTERLY    // 3 Aylık
  SEMI_ANNUAL  // 6 Aylık
  YEARLY       // Yıllık
}

// Eskalasyon Kategorileri (Otomotiv/Üretim Sektörü)
enum EscalationCategory {
  CUSTOMER_LINE_STOP       // Müşteri Hat Durması
  PRODUCT_SAFETY           // Ürün Güvenliği Sorunu
  RECALL                   // Geri Çağırma (Recall)
  CONTROLLED_SHIPPING      // Kontrollü Sevkiyat (CS1/CS2)
  SERIOUS_ACCIDENT         // Ciddi İş Kazası
  ENVIRONMENTAL_INCIDENT   // Çevresel Olay
  CRITICAL_SUPPLY_ISSUE    // Kritik Tedarik Kesintisi
}

// Eskalasyon Öncelik Seviyeleri
enum EscalationPriority {
  LEVEL_4_CRITICAL   // Seviye 4 - Kritik: Anında CEO/GM bildirimi
  LEVEL_3_HIGH       // Seviye 3 - Yüksek: <2 saat içinde Direktör bildirimi
  LEVEL_2_MEDIUM     // Seviye 2 - Orta: <24 saat içinde Müdür bildirimi
  LEVEL_1_LOW        // Seviye 1 - Düşük: <48 saat içinde Şef/Lider bildirimi
}

// Görev Email Logları
model TaskEmailLog {
  id              String   @id @default(cuid())
  taskId          String
  task            PlannedTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  recipientEmails String   @db.Text
  emailType       TaskEmailType
  subject         String
  body            String   @db.Text
  sentAt          DateTime @default(now())
  status          EmailStatus @default(PENDING)
  errorMessage    String?  @db.Text

  @@index([taskId])
  @@index([sentAt])
}

enum TaskEmailType {
  REMINDER       // Hatırlatma
  OVERDUE        // Gecikme bildirimi
  COMPLETED      // Tamamlandı bildirimi
  ESCALATION_MANAGER    // Yöneticiye eskalasyon (1 gün gecikme)
  ESCALATION_EXECUTIVE  // Üst yönetime eskalasyon (5 gün gecikme)
}

// Planlı Görevler Bildirim E-posta Adresleri
model TaskNotificationEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?  // Opsiyonel isim
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Eskalasyon Ayarları
model TaskEscalationSettings {
  id                    String   @id @default(cuid())
  managerEscalationDays Int      @default(1)  // Yöneticiye kaç gün sonra eskalasyon
  executiveEscalationDays Int    @default(5)  // Üst yönetime kaç gün sonra eskalasyon
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Üst Yönetim E-posta Listesi (Eskalasyon için)
model TaskExecutiveEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ==========================================
// Öneri Sistemi Modülü (Kaizen)
// ==========================================

// Öneri Kategorileri
model SuggestionCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?  // Renk kodu (örn: #10b981)
  icon        String?  // İkon adı (lucide)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  suggestions Suggestion[]

  @@index([isActive, sortOrder])
}

// Ana Öneri Tablosu
model Suggestion {
  id                String   @id @default(cuid())
  suggestionNumber  String   @unique // ONR-2025-0001 formatında
  title             String
  description       String   @db.Text

  // Öneri Detayları
  currentSituation  String?  @db.Text // Mevcut durum
  proposedSolution  String?  @db.Text // Önerilen çözüm
  expectedBenefit   String?  @db.Text // Beklenen fayda
  estimatedSavings  Float?            // Tahmini tasarruf (TL)

  // Kategori
  categoryId        String?
  category          SuggestionCategory? @relation(fields: [categoryId], references: [id])

  // Öncelik ve Tip
  priority          SuggestionPriority @default(NORMAL)
  suggestionType    SuggestionType     @default(IMPROVEMENT)

  // Gönderen Bilgileri
  submittedBy       String   // Email adresi
  submittedByName   String   // AD'den alınan isim
  submittedByDept   String?  // Departman
  isAnonymous       Boolean  @default(false) // Anonim mi?

  // Durum Yönetimi
  status            SuggestionStatus @default(SUBMITTED)

  // Onay Akışı - Mevcut Aşama
  currentApprovalLevel Int    @default(1) // 1: Dept Manager, 2: Related Unit, 3: Executive

  // Atama ve Değerlendirme
  assignedTo        String?  // Değerlendirecek kişi email
  assignedToName    String?
  assignedDept      String?  // Değerlendirecek departman

  // Uygulama Bilgileri
  implementedBy     String?
  implementedByName String?
  implementedDate   DateTime?
  actualSavings     Float?   // Gerçekleşen tasarruf

  // Değerlendirme Notları
  evaluationNotes   String?  @db.Text
  rejectionReason   String?  @db.Text

  // Dosya Ekleri
  attachments       String?  @db.Text // JSON array of file URLs

  // Puanlama
  points            Int      @default(0) // Kazanılan puan

  // Metadata
  isActive          Boolean  @default(true)
  submittedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // İlişkiler
  approvalHistory   SuggestionApproval[]
  comments          SuggestionComment[]
  timeline          SuggestionTimeline[]

  @@index([status])
  @@index([categoryId])
  @@index([submittedBy])
  @@index([priority])
  @@index([submittedAt])
  @@index([suggestionNumber])
}

// Öneri Durumları
enum SuggestionStatus {
  SUBMITTED         // Gönderildi
  UNDER_REVIEW      // İnceleniyor
  PENDING_APPROVAL  // Onay Bekliyor
  APPROVED          // Onaylandı
  REJECTED          // Reddedildi
  IN_PROGRESS       // Uygulamada
  IMPLEMENTED       // Uygulandı
  CLOSED            // Kapatıldı
  WITHDRAWN         // Geri Çekildi
}

// Öneri Öncelikleri
enum SuggestionPriority {
  LOW               // Düşük
  NORMAL            // Normal
  HIGH              // Yüksek
  CRITICAL          // Kritik
}

// Öneri Tipleri
enum SuggestionType {
  IMPROVEMENT       // Süreç İyileştirme
  COST_REDUCTION    // Maliyet Azaltma
  SAFETY            // İş Güvenliği
  QUALITY           // Kalite
  PRODUCTIVITY      // Verimlilik
  ENVIRONMENT       // Çevre
  EMPLOYEE_WELFARE  // Çalışan Refahı
  OTHER             // Diğer
}

// Onay Geçmişi
model SuggestionApproval {
  id              String   @id @default(cuid())
  suggestionId    String
  suggestion      Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  approvalLevel   Int      // 1, 2, 3...
  approverEmail   String
  approverName    String
  approverRole    String?

  decision        ApprovalDecision
  comments        String?  @db.Text

  createdAt       DateTime @default(now())

  @@index([suggestionId])
  @@index([approverEmail])
}

enum ApprovalDecision {
  APPROVED          // Onaylandı
  REJECTED          // Reddedildi
  RETURNED          // Düzeltme için iade
  FORWARDED         // Bir sonraki aşamaya iletildi
}

// Öneri Yorumları
model SuggestionComment {
  id              String   @id @default(cuid())
  suggestionId    String
  suggestion      Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  authorEmail     String
  authorName      String
  content         String   @db.Text
  isInternal      Boolean  @default(false) // Sadece yöneticiler görebilir

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([suggestionId])
}

// Öneri Zaman Çizelgesi (Timeline)
model SuggestionTimeline {
  id              String   @id @default(cuid())
  suggestionId    String
  suggestion      Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  action          String   // Durum değişikliği, yorum, onay, vb.
  description     String
  performedBy     String
  performedByName String
  oldStatus       SuggestionStatus?
  newStatus       SuggestionStatus?

  createdAt       DateTime @default(now())

  @@index([suggestionId])
  @@index([createdAt])
}

// Öneri Sistem Ayarları
model SuggestionSettings {
  id                      String   @id @default(cuid())

  // Puan Sistemi
  pointsPerApproved       Int      @default(10)  // Onaylanan öneri puanı
  pointsPerImplemented    Int      @default(25)  // Uygulanan öneri puanı
  bonusPointsForSavings   Boolean  @default(true) // Tasarruf için bonus puan

  // Onay Akışı
  requireDeptApproval     Boolean  @default(true)  // Departman onayı gerekli mi
  requireUnitApproval     Boolean  @default(true)  // İlgili birim onayı gerekli mi
  requireExecApproval     Boolean  @default(false) // Üst yönetim onayı gerekli mi (büyük projeler)
  execApprovalThreshold   Float    @default(10000) // Üst yönetim onayı için tasarruf eşiği

  // Bildirimler
  notifyOnSubmission      Boolean  @default(true)
  notifyOnApproval        Boolean  @default(true)
  notifyOnRejection       Boolean  @default(true)
  notifyOnImplementation  Boolean  @default(true)

  // Anonimlik
  allowAnonymous          Boolean  @default(true)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// Öneri Değerlendiricileri (Hangi departman hangi kategorileri değerlendirir)
model SuggestionEvaluator {
  id              String   @id @default(cuid())
  categoryId      String?  // null ise tüm kategoriler
  department      String   // Değerlendirici departman
  evaluatorEmail  String   // Değerlendirici email
  evaluatorName   String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([categoryId])
  @@index([department])
  @@index([isActive])
}

// Öneri Kurulu Üyeleri
model SuggestionBoardMember {
  id              String   @id @default(cuid())
  email           String   @unique  // AD'den seçilen kişinin email adresi
  name            String            // Kişi adı
  department      String?           // Departman
  role            String?           // Kuruldaki rolü (Başkan, Üye, vb.)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
}

// ==========================================
// Kaizen Projeleri Modülü
// ==========================================

// Kaizen Projesi
model KaizenProject {
  id                String   @id @default(cuid())
  projectNumber     String   @unique // KZN-2025-0001 formatında
  title             String
  description       String   @db.Text

  // İlişkili Öneri (Opsiyonel - öneriden dönüşebilir)
  suggestionId      String?

  // Proje Tipi
  projectType       KaizenType @default(INDIVIDUAL)

  // Problem Tanımı (5N1K)
  problemWhat       String?  @db.Text  // Ne? - Problem nedir?
  problemWhy        String?  @db.Text  // Neden? - Neden önemli?
  problemWhere      String?  @db.Text  // Nerede? - Hangi alanda?
  problemWhen       String?  @db.Text  // Ne zaman? - Ne zaman oluşuyor?
  problemWho        String?  @db.Text  // Kim? - Kimleri etkiliyor?
  problemHow        String?  @db.Text  // Nasıl? - Nasıl tespit edildi?

  // Mevcut Durum
  currentState      String?  @db.Text
  currentMetrics    String?  @db.Text  // JSON: Mevcut ölçümler

  // Hedef Durum
  targetState       String?  @db.Text
  targetMetrics     String?  @db.Text  // JSON: Hedef ölçümler

  // Kök Neden Analizi (5 Why)
  rootCauseAnalysis String?  @db.Text  // JSON array of 5 whys

  // Çözüm ve Uygulama
  proposedSolution  String?  @db.Text
  actionPlan        String?  @db.Text  // JSON: Aksiyon planı

  // PDCA Aşaması
  pdcaStage         PDCAStage @default(PLAN)

  // Tarihler
  startDate         DateTime?
  targetEndDate     DateTime?
  actualEndDate     DateTime?

  // Takım
  teamLeaderId      String?
  teamLeaderName    String?
  teamLeaderEmail   String?
  departmentId      String?
  department        String?

  // Sonuçlar
  resultSummary     String?  @db.Text
  actualSavings     Float?
  qualityImprovement Float?  // Yüzde olarak kalite iyileşmesi
  efficiencyImprovement Float? // Yüzde olarak verimlilik iyileşmesi

  // Durum ve Öncelik
  status            KaizenStatus @default(DRAFT)
  priority          SuggestionPriority @default(NORMAL)

  // Metadata
  createdBy         String
  createdByName     String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // İlişkiler
  teamMembers       KaizenTeamMember[]
  pdcaSteps         KaizenPDCAStep[]
  attachments       KaizenAttachment[]
  timeline          KaizenTimeline[]

  @@index([status])
  @@index([pdcaStage])
  @@index([projectNumber])
  @@index([departmentId])
}

enum KaizenType {
  INDIVIDUAL        // Bireysel Kaizen
  TEAM              // Takım Kaizen
  PROJECT           // Proje Kaizen (büyük ölçekli)
  QUICK             // Hızlı Kaizen (Quick Win)
}

enum KaizenStatus {
  DRAFT             // Taslak
  PLANNING          // Planlanıyor
  IN_PROGRESS       // Devam Ediyor
  CHECKING          // Kontrol Ediliyor
  COMPLETED         // Tamamlandı
  STANDARDIZED      // Standartlaştırıldı
  CANCELLED         // İptal Edildi
}

enum PDCAStage {
  PLAN              // Planla
  DO                // Uygula
  CHECK             // Kontrol Et
  ACT               // Önlem Al / Standartlaştır
}

// Kaizen Takım Üyeleri
model KaizenTeamMember {
  id              String   @id @default(cuid())
  projectId       String
  project         KaizenProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  email           String
  name            String
  department      String?
  role            KaizenTeamRole @default(MEMBER)

  createdAt       DateTime @default(now())

  @@index([projectId])
  @@index([email])
}

enum KaizenTeamRole {
  LEADER            // Takım Lideri
  MEMBER            // Üye
  SPONSOR           // Sponsor
  FACILITATOR       // Kolaylaştırıcı
}

// PDCA Adımları (Her aşama için detaylı takip)
model KaizenPDCAStep {
  id              String   @id @default(cuid())
  projectId       String
  project         KaizenProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  stage           PDCAStage
  stepNumber      Int      // 1, 2, 3... sıralama
  title           String
  description     String?  @db.Text
  responsibleEmail String?
  responsibleName String?

  dueDate         DateTime?
  completedDate   DateTime?
  status          TaskStatus @default(PENDING)

  notes           String?  @db.Text
  evidence        String?  @db.Text // JSON: Kanıt dosyaları

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([stage])
}

// Kaizen Dosya Ekleri
model KaizenAttachment {
  id              String   @id @default(cuid())
  projectId       String
  project         KaizenProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fileName        String
  fileUrl         String
  fileType        String?
  fileSize        Int?
  category        String?  // before, after, evidence, document

  uploadedBy      String
  uploadedByName  String
  createdAt       DateTime @default(now())

  @@index([projectId])
}

// Kaizen Zaman Çizelgesi
model KaizenTimeline {
  id              String   @id @default(cuid())
  projectId       String
  project         KaizenProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  action          String
  description     String
  performedBy     String
  performedByName String
  oldStage        PDCAStage?
  newStage        PDCAStage?

  createdAt       DateTime @default(now())

  @@index([projectId])
}

// ==========================================
// Ramak Kala (Near Miss) Modülü
// ==========================================

// Ramak Kala Bildirimi
model NearMiss {
  id                String   @id @default(cuid())
  reportNumber      String   @unique // RMK-2025-0001 formatında

  // Olay Bilgileri
  title             String
  description       String   @db.Text
  eventDate         DateTime // Olayın gerçekleştiği tarih/saat
  eventLocation     String   // Olayın yeri
  locationDetails   String?  @db.Text // Detaylı konum açıklaması

  // Olay Tipi
  eventType         NearMissType
  potentialSeverity NearMissSeverity // Olabilecek en kötü sonuç

  // 5N1K Analizi
  whatHappened      String?  @db.Text  // Ne oldu?
  whyHappened       String?  @db.Text  // Neden oldu?
  howHappened       String?  @db.Text  // Nasıl oldu?

  // Etkilenen/Risk Altındaki
  affectedPersons   String?  @db.Text  // Etkilenebilecek kişiler
  affectedEquipment String?  @db.Text  // Etkilenebilecek ekipman

  // Bildiren Bilgileri
  reportedBy        String   // Email
  reportedByName    String
  reportedByDept    String?
  isAnonymous       Boolean  @default(false)

  // Tanıklar
  witnesses         String?  @db.Text  // JSON array

  // Durum ve Takip
  status            NearMissStatus @default(REPORTED)
  investigationNotes String? @db.Text

  // Kök Neden Analizi
  rootCause         String?  @db.Text
  rootCauseCategory RootCauseCategory?

  // Düzeltici Faaliyetler
  correctiveActions String?  @db.Text  // JSON array

  // Atama
  assignedTo        String?
  assignedToName    String?
  assignedDept      String?

  // Kapanış
  closedBy          String?
  closedByName      String?
  closedAt          DateTime?
  closureNotes      String?  @db.Text

  // GPS Koordinatları (Opsiyonel)
  latitude          Float?
  longitude         Float?

  // Metadata
  isActive          Boolean  @default(true)
  reportedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // İlişkiler
  attachments       NearMissAttachment[]
  actions           NearMissAction[]
  timeline          NearMissTimeline[]

  @@index([status])
  @@index([eventType])
  @@index([reportNumber])
  @@index([reportedAt])
  @@index([potentialSeverity])
}

enum NearMissType {
  FALLING           // Düşme
  SLIPPING          // Kayma
  TRIPPING          // Takılma
  COLLISION         // Çarpışma
  FALLING_OBJECT    // Düşen Cisim
  ELECTRICAL        // Elektrik
  FIRE              // Yangın
  CHEMICAL          // Kimyasal
  MACHINERY         // Makine/Ekipman
  VEHICLE           // Araç
  ERGONOMIC         // Ergonomik
  ENVIRONMENTAL     // Çevresel
  OTHER             // Diğer
}

enum NearMissSeverity {
  MINOR             // Hafif (İlk yardım gerektiren)
  MODERATE          // Orta (Tıbbi müdahale gerektiren)
  MAJOR             // Ciddi (Hastaneye yatış)
  CRITICAL          // Kritik (Kalıcı sakatlık riski)
  FATAL             // Ölümcül risk
}

enum NearMissStatus {
  REPORTED          // Bildirildi
  UNDER_INVESTIGATION // Araştırılıyor
  ACTION_REQUIRED   // Aksiyon Gerekli
  IN_PROGRESS       // İşlemde
  RESOLVED          // Çözüldü
  CLOSED            // Kapatıldı
}

enum RootCauseCategory {
  HUMAN_ERROR       // İnsan Hatası
  EQUIPMENT_FAILURE // Ekipman Arızası
  PROCEDURE_GAP     // Prosedür Eksikliği
  TRAINING_GAP      // Eğitim Eksikliği
  ENVIRONMENTAL     // Çevresel Faktörler
  MANAGEMENT        // Yönetimsel
  DESIGN_FLAW       // Tasarım Hatası
  COMMUNICATION     // İletişim Eksikliği
  OTHER             // Diğer
}

// Ramak Kala Dosya Ekleri
model NearMissAttachment {
  id              String   @id @default(cuid())
  nearMissId      String
  nearMiss        NearMiss @relation(fields: [nearMissId], references: [id], onDelete: Cascade)

  fileName        String
  fileUrl         String
  fileType        String?  // image, video, document
  fileSize        Int?

  uploadedBy      String
  uploadedByName  String
  createdAt       DateTime @default(now())

  @@index([nearMissId])
}

// Ramak Kala Düzeltici Faaliyetler
model NearMissAction {
  id              String   @id @default(cuid())
  nearMissId      String
  nearMiss        NearMiss @relation(fields: [nearMissId], references: [id], onDelete: Cascade)

  actionType      ActionType
  description     String   @db.Text
  priority        SuggestionPriority @default(NORMAL)

  assignedTo      String?
  assignedToName  String?
  assignedDept    String?

  dueDate         DateTime?
  completedDate   DateTime?
  status          TaskStatus @default(PENDING)

  evidence        String?  @db.Text  // Tamamlandı kanıtı
  notes           String?  @db.Text

  createdBy       String
  createdByName   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([nearMissId])
  @@index([status])
}

enum ActionType {
  IMMEDIATE         // Acil Önlem
  CORRECTIVE        // Düzeltici Faaliyet
  PREVENTIVE        // Önleyici Faaliyet
}

// Ramak Kala Zaman Çizelgesi
model NearMissTimeline {
  id              String   @id @default(cuid())
  nearMissId      String
  nearMiss        NearMiss @relation(fields: [nearMissId], references: [id], onDelete: Cascade)

  action          String
  description     String
  performedBy     String
  performedByName String
  oldStatus       NearMissStatus?
  newStatus       NearMissStatus?

  createdAt       DateTime @default(now())

  @@index([nearMissId])
}

// ==========================================
// 5S Denetim Modülü
// ==========================================

// 5S Denetim Alanları
model FiveSArea {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique // ÜRETİM-A1, DEPO-B2 gibi
  description     String?
  department      String?
  location        String?
  responsibleEmail String?
  responsibleName String?

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  audits          FiveSAudit[]

  @@index([department])
  @@index([isActive])
}

// 5S Denetim Şablonları
model FiveSTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?
  version         String   @default("1.0")

  // Her S için kriterler (JSON array)
  seiriCriteria   String   @db.Text  // Ayıklama kriterleri
  seitonCriteria  String   @db.Text  // Düzenleme kriterleri
  seisoCriteria   String   @db.Text  // Temizleme kriterleri
  seiketsuCriteria String  @db.Text  // Standartlaştırma kriterleri
  shitsukeCriteria String  @db.Text  // Disiplin kriterleri

  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdBy       String
  createdByName   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  audits          FiveSAudit[]

  @@index([isActive])
}

// 5S Denetim
model FiveSAudit {
  id              String   @id @default(cuid())
  auditNumber     String   @unique // 5S-2025-0001 formatında

  // Denetim Bilgileri
  areaId          String
  area            FiveSArea @relation(fields: [areaId], references: [id])
  templateId      String?
  template        FiveSTemplate? @relation(fields: [templateId], references: [id])

  auditDate       DateTime
  auditType       FiveSAuditType @default(REGULAR)

  // Denetçi
  auditorEmail    String
  auditorName     String

  // Puanlar (Her S için 0-100)
  seiriScore      Int      @default(0)  // Ayıklama
  seitonScore     Int      @default(0)  // Düzenleme
  seisoScore      Int      @default(0)  // Temizleme
  seiketsuScore   Int      @default(0)  // Standartlaştırma
  shitsukeScore   Int      @default(0)  // Disiplin
  totalScore      Int      @default(0)  // Toplam (ortalama)

  // Detaylı Değerlendirmeler (JSON)
  seiriDetails    String?  @db.Text
  seitonDetails   String?  @db.Text
  seisoDetails    String?  @db.Text
  seiketsuDetails String?  @db.Text
  shitsukeDetails String?  @db.Text

  // Genel Notlar
  strengths       String?  @db.Text  // Güçlü yönler
  improvements    String?  @db.Text  // İyileştirme alanları
  notes           String?  @db.Text

  // Durum
  status          FiveSAuditStatus @default(DRAFT)

  // Aksiyon Planı
  actionPlanStatus   ActionPlanStatus? // Aksiyon planı durumu
  actionPlanCreatedAt DateTime?        // Aksiyon planı oluşturulma tarihi
  actionPlanCreatedBy String?          // Aksiyon planını oluşturan (Kalite Müdürü)

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // İlişkiler
  findings        FiveSFinding[]
  photos          FiveSPhoto[]

  @@index([areaId])
  @@index([auditDate])
  @@index([status])
}

enum FiveSAuditType {
  REGULAR           // Düzenli denetim
  SPOT              // Anlık denetim
  FOLLOWUP          // Takip denetimi
  EXTERNAL          // Dış denetim
}

enum FiveSAuditStatus {
  DRAFT             // Taslak
  IN_PROGRESS       // Devam Ediyor
  COMPLETED         // Tamamlandı
  REVIEWED          // İncelendi
}

enum ActionPlanStatus {
  NOT_REQUIRED      // Aksiyon planı gerekli değil
  PENDING           // Aksiyon planı bekleniyor
  CREATED           // Aksiyon planı oluşturuldu
  IN_PROGRESS       // Aksiyonlar devam ediyor
  COMPLETED         // Tüm aksiyonlar tamamlandı
}

// 5S Bulgular (Uygunsuzluklar ve İyileştirme Fırsatları)
model FiveSFinding {
  id              String   @id @default(cuid())
  auditId         String
  audit           FiveSAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  sCategory       FiveSCategory  // Hangi S ile ilgili
  findingType     FindingType
  description     String   @db.Text
  location        String?  // Alan içindeki konum

  priority        SuggestionPriority @default(NORMAL)
  status          TaskStatus @default(PENDING)

  // Düzeltici Aksiyon
  correctiveAction String? @db.Text
  assignedTo      String?
  assignedToName  String?
  dueDate         DateTime?
  completedDate   DateTime?

  // PlannedTask Entegrasyonu - Planlı görev ile ilişki
  plannedTaskId   String?  @unique
  plannedTask     PlannedTask? @relation(fields: [plannedTaskId], references: [id])

  // Kanıtlar
  beforePhotoUrl  String?
  afterPhotoUrl   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([auditId])
  @@index([sCategory])
  @@index([status])
}

enum FiveSCategory {
  SEIRI             // Ayıklama (Sort)
  SEITON            // Düzenleme (Set in Order)
  SEISO             // Temizleme (Shine)
  SEIKETSU          // Standartlaştırma (Standardize)
  SHITSUKE          // Disiplin (Sustain)
}

enum FindingType {
  NON_CONFORMITY    // Uygunsuzluk
  OBSERVATION       // Gözlem
  IMPROVEMENT       // İyileştirme Fırsatı
  BEST_PRACTICE     // En İyi Uygulama
}

// 5S Denetim Fotoğrafları
model FiveSPhoto {
  id              String   @id @default(cuid())
  auditId         String
  audit           FiveSAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  sCategory       FiveSCategory?
  photoType       PhotoType
  fileUrl         String
  caption         String?
  location        String?  // Alan içindeki konum

  uploadedBy      String
  uploadedByName  String
  createdAt       DateTime @default(now())

  @@index([auditId])
}

enum PhotoType {
  BEFORE            // Öncesi
  AFTER             // Sonrası
  EVIDENCE          // Kanıt
  GENERAL           // Genel
}

// 5S Denetim Planı (Periyodik denetimler için)
model FiveSSchedule {
  id              String   @id @default(cuid())
  areaId          String
  frequency       RecurrenceType  // WEEKLY, MONTHLY, vb.
  dayOfWeek       Int?     // Haftanın günü (0-6)
  dayOfMonth      Int?     // Ayın günü (1-31)

  auditorEmail    String?  // Varsayılan denetçi
  auditorName     String?

  lastAuditDate   DateTime?
  nextAuditDate   DateTime?

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([areaId])
  @@index([nextAuditDate])
}

// ==========================================
// Puan ve Ödül Sistemi
// ==========================================

// Çalışan Puanları
model EmployeePoints {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  department      String?

  // Puan Kategorileri
  suggestionPoints Int     @default(0)  // Öneri puanları
  kaizenPoints    Int      @default(0)  // Kaizen puanları
  nearMissPoints  Int      @default(0)  // Ramak kala bildirim puanları
  fiveSPoints     Int      @default(0)  // 5S puanları
  totalPoints     Int      @default(0)  // Toplam

  // Başarılar
  badgesEarned    String?  @db.Text  // JSON array of badge IDs
  level           Int      @default(1)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // İlişkiler
  pointHistory    PointHistory[]

  @@index([totalPoints])
  @@index([department])
}

// Puan Geçmişi
model PointHistory {
  id              String   @id @default(cuid())
  employeePointsId String
  employeePoints  EmployeePoints @relation(fields: [employeePointsId], references: [id], onDelete: Cascade)

  points          Int      // + veya - olabilir
  category        PointCategory
  reason          String
  referenceId     String?  // İlgili kaydın ID'si
  referenceType   String?  // Suggestion, Kaizen, NearMiss, FiveS

  createdAt       DateTime @default(now())

  @@index([employeePointsId])
  @@index([category])
}

enum PointCategory {
  SUGGESTION_SUBMITTED    // Öneri gönderildi
  SUGGESTION_APPROVED     // Öneri onaylandı
  SUGGESTION_IMPLEMENTED  // Öneri uygulandı
  KAIZEN_PARTICIPATED     // Kaizen projesine katılım
  KAIZEN_COMPLETED        // Kaizen projesi tamamlandı
  NEARMISS_REPORTED       // Ramak kala bildirimi
  NEARMISS_RESOLVED       // Ramak kala çözüldü
  FIVES_AUDIT             // 5S denetimi yapıldı
  FIVES_IMPROVEMENT       // 5S iyileştirmesi
  BONUS                   // Bonus puan
  PENALTY                 // Ceza puanı
}

// Rozetler/Başarılar
model Badge {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String
  icon            String   // İkon URL veya emoji
  color           String?
  category        String   // suggestion, kaizen, nearmiss, fives, general
  requiredPoints  Int?     // Bu rozet için gereken puan
  requiredCount   Int?     // Bu rozet için gereken eylem sayısı

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([category])
}

// ==========================================
// Duyuru/Haber Sistemi Modülü
// ==========================================

// Duyuru Kategorileri
model AnnouncementCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?  // Renk kodu (örn: #3b82f6)
  icon        String?  // İkon adı (lucide)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  announcements Announcement[]

  @@index([isActive, sortOrder])
}

// Ana Duyuru Tablosu
model Announcement {
  id                String   @id @default(cuid())

  // Temel Bilgiler
  title             String
  summary           String?  @db.Text  // Kısa özet (liste görünümü için)
  content           String   @db.Text  // Tam içerik (HTML/Markdown)

  // Kategori ve Öncelik
  categoryId        String?
  category          AnnouncementCategory? @relation(fields: [categoryId], references: [id])
  priority          AnnouncementPriority @default(NORMAL)

  // Hedef Kitle
  targetType        AnnouncementTarget @default(ALL)
  targetDepartments String[] // Hedef departmanlar (targetType=DEPARTMENTS ise)
  targetRoles       String[] // Hedef roller (targetType=ROLES ise)

  // Görsel ve Medya
  coverImageUrl     String?  // Kapak görseli
  attachments       String?  @db.Text  // JSON array of file URLs

  // Yayın Ayarları
  status            AnnouncementStatus @default(DRAFT)
  isPinned          Boolean  @default(false)  // Üstte sabitlensin mi?
  publishAt         DateTime? // Zamanlanmış yayın tarihi
  expiresAt         DateTime? // Geçerlilik bitiş tarihi

  // Etkileşim Ayarları
  allowComments     Boolean  @default(true)
  allowReactions    Boolean  @default(true)
  requireAcknowledgment Boolean @default(false) // Okundu onayı gerekli mi?

  // İlişkili Anket
  surveyId          String?
  survey            Survey?  @relation(fields: [surveyId], references: [id])

  // Yazar Bilgileri
  authorId          String
  authorEmail       String
  authorName        String
  authorDepartment  String?

  // İstatistikler
  viewCount         Int      @default(0)

  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  publishedAt       DateTime?

  // İlişkiler
  reads             AnnouncementRead[]
  comments          AnnouncementComment[]
  reactions         AnnouncementReaction[]

  @@index([status])
  @@index([categoryId])
  @@index([priority])
  @@index([publishAt])
  @@index([expiresAt])
  @@index([isPinned])
}

// Duyuru Öncelikleri
enum AnnouncementPriority {
  LOW               // Düşük
  NORMAL            // Normal
  HIGH              // Yüksek
  URGENT            // Acil (Kırmızı banner)
}

// Duyuru Hedef Kitlesi
enum AnnouncementTarget {
  ALL               // Tüm çalışanlar
  DEPARTMENTS       // Belirli departmanlar
  ROLES             // Belirli roller
}

// Duyuru Durumları
enum AnnouncementStatus {
  DRAFT             // Taslak
  SCHEDULED         // Zamanlanmış
  PUBLISHED         // Yayında
  ARCHIVED          // Arşivlenmiş
}

// Duyuru Okunma Kaydı
model AnnouncementRead {
  id              String   @id @default(cuid())
  announcementId  String
  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  userEmail       String
  userName        String
  userDepartment  String?

  readAt          DateTime @default(now())
  acknowledged    Boolean  @default(false) // Okundu onayı verdiyse true
  acknowledgedAt  DateTime?

  @@unique([announcementId, userEmail])
  @@index([announcementId])
  @@index([userEmail])
}

// Duyuru Yorumları
model AnnouncementComment {
  id              String   @id @default(cuid())
  announcementId  String
  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  authorEmail     String
  authorName      String
  content         String   @db.Text

  // Üst yorum (thread için)
  parentId        String?
  parent          AnnouncementComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies         AnnouncementComment[] @relation("CommentReplies")

  isApproved      Boolean  @default(true) // Moderasyon için
  isEdited        Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([announcementId])
  @@index([parentId])
}

// Duyuru Tepkileri (Beğeni, kalp, vb.)
model AnnouncementReaction {
  id              String   @id @default(cuid())
  announcementId  String
  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  userEmail       String
  userName        String
  reactionType    ReactionType @default(LIKE)

  createdAt       DateTime @default(now())

  @@unique([announcementId, userEmail, reactionType])
  @@index([announcementId])
}

enum ReactionType {
  LIKE              // 👍
  LOVE              // ❤️
  CELEBRATE         // 🎉
  INSIGHTFUL        // 💡
  SUPPORT           // 🙏
}

// ==========================================
// Anket (Survey) Sistemi
// ==========================================

// Ana Anket Tablosu
model Survey {
  id                String   @id @default(cuid())
  surveyNumber      String   @unique // ANK-2025-0001 formatında

  // Temel Bilgiler
  title             String
  description       String?  @db.Text

  // Anket Tipi
  surveyType        SurveyType @default(POLL)

  // Zaman Ayarları
  startsAt          DateTime?
  endsAt            DateTime?

  // Katılım Ayarları
  isAnonymous       Boolean  @default(false) // Anonim yanıtlar
  allowMultipleResponses Boolean @default(false) // Aynı kişi birden fazla yanıt verebilir mi?
  requireAllQuestions Boolean @default(true) // Tüm sorular zorunlu mu?
  showResults       SurveyResultVisibility @default(AFTER_SUBMIT)

  // Hedef Kitle
  targetType        AnnouncementTarget @default(ALL)
  targetDepartments String[]
  targetRoles       String[]

  // Durum
  status            SurveyStatus @default(DRAFT)

  // Public Erişim (login gerektirmeden)
  isPublic          Boolean  @default(false) // Public erişime açık mı?
  publicSlug        String?  @unique // Public erişim linki (örn: mavi-yaka-anketi-2025)

  // Oluşturan
  createdBy         String
  createdByName     String
  createdByEmail    String

  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // İlişkiler
  questions         SurveyQuestion[]
  responses         SurveyResponse[]
  announcements     Announcement[]

  @@index([status])
  @@index([endsAt])
  @@index([isPublic])
  @@index([publicSlug])
}

// Anket Tipleri
enum SurveyType {
  POLL              // Hızlı oylama (tek soru)
  SURVEY            // Detaylı anket (çoklu soru)
  FEEDBACK          // Geri bildirim formu
  QUIZ              // Quiz/Sınav
}

// Anket Durumları
enum SurveyStatus {
  DRAFT             // Taslak
  ACTIVE            // Aktif
  CLOSED            // Kapatıldı
  ARCHIVED          // Arşivlenmiş
}

// Sonuç Görünürlüğü
enum SurveyResultVisibility {
  ALWAYS            // Her zaman görünür
  AFTER_SUBMIT      // Yanıtladıktan sonra görünür
  AFTER_END         // Anket bittikten sonra görünür
  NEVER             // Sadece yöneticiler görebilir
}

// Anket Soruları
model SurveyQuestion {
  id              String   @id @default(cuid())
  surveyId        String
  survey          Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  questionText    String   @db.Text
  questionType    QuestionType
  isRequired      Boolean  @default(true)
  sortOrder       Int      @default(0)

  // Koşullu gösterim (opsiyonel)
  showIf          String?  @db.Text // JSON: {questionId, operator, value}

  // Validasyon kuralları (opsiyonel)
  minValue        Int?     // Sayısal sorular için
  maxValue        Int?
  minLength       Int?     // Metin sorular için
  maxLength       Int?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // İlişkiler
  options         SurveyOption[]
  answers         SurveyAnswer[]

  @@index([surveyId])
  @@index([sortOrder])
}

// Soru Tipleri
enum QuestionType {
  SINGLE_CHOICE     // Tek seçim (radio)
  MULTIPLE_CHOICE   // Çoklu seçim (checkbox)
  TEXT_SHORT        // Kısa metin
  TEXT_LONG         // Uzun metin (textarea)
  RATING            // Puanlama (1-5 yıldız)
  SCALE             // Ölçek (1-10)
  YES_NO            // Evet/Hayır
  DATE              // Tarih seçimi
  FILE_UPLOAD       // Dosya yükleme
  DROPDOWN          // Dropdown seçim
  MATRIX            // Matris sorusu
}

// Anket Seçenekleri (Çoktan seçmeli sorular için)
model SurveyOption {
  id              String   @id @default(cuid())
  questionId      String
  question        SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  optionText      String
  sortOrder       Int      @default(0)
  isOther         Boolean  @default(false) // "Diğer" seçeneği mi?

  createdAt       DateTime @default(now())

  // İlişkiler
  answers         SurveyAnswer[]

  @@index([questionId])
  @@index([sortOrder])
}

// Anket Yanıtları (Bir kullanıcının tüm yanıtları)
model SurveyResponse {
  id              String   @id @default(cuid())
  surveyId        String
  survey          Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  // Yanıtlayan (anonim değilse)
  respondentEmail String?
  respondentName  String?
  respondentDepartment String?

  // Anonim tanımlayıcı (anonim ise)
  anonymousId     String?

  // Tamamlanma durumu
  isComplete      Boolean  @default(false)
  completedAt     DateTime?

  // IP ve User Agent (opsiyonel, analiz için)
  ipAddress       String?
  userAgent       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // İlişkiler
  answers         SurveyAnswer[]

  @@index([surveyId])
  @@index([respondentEmail])
  @@index([isComplete])
}

// Anket Cevapları (Her soru için ayrı cevap)
model SurveyAnswer {
  id              String   @id @default(cuid())
  responseId      String
  response        SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  questionId      String
  question        SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Seçilen seçenek (çoktan seçmeli için)
  optionId        String?
  option          SurveyOption? @relation(fields: [optionId], references: [id])

  // Metin cevap (açık uçlu sorular veya "diğer" için)
  textAnswer      String?  @db.Text

  // Sayısal cevap (puanlama/ölçek için)
  numericAnswer   Int?

  // Tarih cevap (tarih soruları için)
  dateAnswer      DateTime?

  // Dosya cevap (dosya yükleme için)
  fileUrl         String?

  createdAt       DateTime @default(now())

  @@index([responseId])
  @@index([questionId])
  @@index([optionId])
}

// ==========================================
// Dahili Mesajlasma Sistemi
// ==========================================

// Konusma (Conversation) - 1-1 veya Grup
model Conversation {
  id              String   @id @default(cuid())
  name            String?  // Grup konusmasi icin isim
  isGroup         Boolean  @default(false)

  // Son mesaj bilgisi (performans icin)
  lastMessageAt   DateTime?
  lastMessageText String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Iliskiler
  participants    ConversationParticipant[]
  messages        Message[]

  @@index([lastMessageAt])
}

// Konusma Katilimcilari
model ConversationParticipant {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userEmail       String
  userName        String
  userDepartment  String?

  // Okunma durumu
  lastReadAt      DateTime?
  unreadCount     Int      @default(0)

  // Bildirim tercihi
  isMuted         Boolean  @default(false)

  joinedAt        DateTime @default(now())
  leftAt          DateTime? // Gruptan ayrilma
  clearedAt       DateTime? // Mesajların bu tarihten öncekiler gösterilmez

  @@unique([conversationId, userEmail])
  @@index([userEmail])
  @@index([conversationId])
}

// Mesajlar
model Message {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderEmail     String
  senderName      String
  content         String   @db.Text

  // Mesaj tipi
  messageType     MessageType @default(TEXT)

  // Dosya eki
  attachmentUrl   String?
  attachmentName  String?
  attachmentType  String?

  // Yanitlanan mesaj
  replyToId       String?
  replyTo         Message? @relation("MessageReplies", fields: [replyToId], references: [id])
  replies         Message[] @relation("MessageReplies")

  // Durum
  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?
  isEdited        Boolean  @default(false)
  editedAt        DateTime?

  createdAt       DateTime @default(now())

  // Iliskiler
  readReceipts    MessageReadReceipt[]

  @@index([conversationId])
  @@index([senderEmail])
  @@index([createdAt])
}

enum MessageType {
  TEXT              // Normal mesaj
  FILE              // Dosya
  IMAGE             // Resim
  SYSTEM            // Sistem mesaji (kullanici katildi, vs.)
}

// Mesaj Okunma Bilgisi
model MessageReadReceipt {
  id              String   @id @default(cuid())
  messageId       String
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userEmail       String
  readAt          DateTime @default(now())

  @@unique([messageId, userEmail])
  @@index([messageId])
}

// ==========================================
// IT Ticket Sistemi Modülü
// ==========================================

// Ticket Kategorileri
model TicketCategory {
  id          String   @id @default(cuid())
  name        String   @unique    // "Yazılım Sorunu", "Donanım Arızası", vb.
  description String?
  color       String?             // #3b82f6
  icon        String?             // lucide icon adı
  parentId    String?             // Alt kategori için
  parent      TicketCategory? @relation("SubCategories", fields: [parentId], references: [id])
  children    TicketCategory[] @relation("SubCategories")

  // SLA Ayarları (kategori bazlı)
  defaultPriority      TicketPriority @default(NORMAL)
  slaResponseMinutes   Int?           // Varsayılan yanıt SLA (dakika)
  slaResolutionMinutes Int?           // Varsayılan çözüm SLA (dakika)

  // Varsayılan Atama
  defaultAssigneeEmail String?        // Varsayılan atanan kişi
  defaultTeamId        String?        // Varsayılan ekip
  defaultTeam          TicketTeam?    @relation(fields: [defaultTeamId], references: [id])

  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets     Ticket[]

  @@index([isActive, sortOrder])
  @@index([parentId])
}

// IT Ekipleri
model TicketTeam {
  id          String   @id @default(cuid())
  name        String   @unique     // "Altyapı Ekibi", "Yazılım Ekibi"
  description String?
  leadEmail   String?              // Ekip lideri email
  leadName    String?

  // Üyeler (JSON array of {email, name})
  members     String   @db.Text    // JSON array

  // Çalışma saatleri
  workingHoursStart String?        // "09:00"
  workingHoursEnd   String?        // "18:00"
  workingDays       Int[]          // [1,2,3,4,5] Pazartesi-Cuma

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets     Ticket[]
  categories  TicketCategory[]

  @@index([isActive])
}

// Ana Ticket Tablosu
model Ticket {
  id              String   @id @default(cuid())
  ticketNumber    String   @unique  // TKT-2025-0001 formatında

  // Temel Bilgiler
  subject         String              // Konu başlığı
  description     String   @db.Text   // Detaylı açıklama

  // Ticket Tipi (ITIL)
  ticketType      TicketType @default(INCIDENT)

  // Kategori
  categoryId      String?
  category        TicketCategory? @relation(fields: [categoryId], references: [id])

  // Öncelik ve Etki
  priority        TicketPriority @default(NORMAL)
  impact          TicketImpact   @default(INDIVIDUAL)
  urgency         TicketUrgency  @default(MEDIUM)

  // Durum
  status          TicketStatus @default(NEW)

  // Talep Eden (Requester)
  requesterEmail  String
  requesterName   String
  requesterDept   String?
  requesterPhone  String?

  // İlgili Lokasyon/Ekipman
  location        String?            // Lokasyon bilgisi
  assetInfo       String?            // İlgili varlık bilgisi (bilgisayar adı vb.)

  // Atama
  assignedTo      String?            // Atanan teknisyen email
  assignedToName  String?
  assignedTeamId  String?            // Atanan ekip
  assignedTeam    TicketTeam? @relation(fields: [assignedTeamId], references: [id])

  // SLA Bilgileri
  slaResponseDue   DateTime?         // Yanıt SLA bitiş zamanı
  slaResolutionDue DateTime?         // Çözüm SLA bitiş zamanı
  respondedAt      DateTime?         // İlk yanıt zamanı
  resolvedAt       DateTime?         // Çözüm zamanı
  closedAt         DateTime?         // Kapanış zamanı
  slaResponseBreached   Boolean @default(false)
  slaResolutionBreached Boolean @default(false)

  // Çözüm
  resolutionSummary String? @db.Text // Çözüm özeti
  rootCause         String? @db.Text // Kök neden

  // Memnuniyet
  satisfactionRating  Int?           // 1-5 yıldız
  satisfactionComment String?

  // İlişkili Ticket (Parent/Child)
  parentTicketId  String?
  parentTicket    Ticket? @relation("TicketHierarchy", fields: [parentTicketId], references: [id])
  childTickets    Ticket[] @relation("TicketHierarchy")

  // Dosya Ekleri
  attachments     String?  @db.Text  // JSON array of file URLs

  // Etiketler
  tags            String[] @default([])

  // Metadata
  source          TicketSource @default(WEB_PORTAL)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // İlişkiler
  comments        TicketComment[]
  timeline        TicketTimeline[]
  workLogs        TicketWorkLog[]

  @@index([status])
  @@index([ticketNumber])
  @@index([requesterEmail])
  @@index([assignedTo])
  @@index([categoryId])
  @@index([priority])
  @@index([createdAt])
  @@index([slaResolutionDue])
}

// Ticket Tipleri (ITIL)
enum TicketType {
  INCIDENT        // Olay - Hizmet kesintisi
  SERVICE_REQUEST // Hizmet Talebi - Standart talep
  PROBLEM         // Problem - Kök neden analizi
  CHANGE_REQUEST  // Değişiklik Talebi
}

// Ticket Durumları
enum TicketStatus {
  NEW             // Yeni - Henüz işlem yapılmadı
  ASSIGNED        // Atandı - Teknisyene atandı
  IN_PROGRESS     // İşlemde - Üzerinde çalışılıyor
  PENDING         // Beklemede - Kullanıcı yanıtı bekleniyor
  ON_HOLD         // Askıda - Harici sebep
  RESOLVED        // Çözüldü - Çözüm uygulandı
  CLOSED          // Kapatıldı - Kullanıcı onayladı
  CANCELLED       // İptal - Talep iptal edildi
  REOPENED        // Yeniden Açıldı
}

// Öncelik
enum TicketPriority {
  TICKET_LOW      // Düşük
  NORMAL          // Normal (mevcut enum ile çakışmasın diye aynı)
  TICKET_HIGH     // Yüksek
  TICKET_CRITICAL // Kritik
}

// Etki Alanı
enum TicketImpact {
  INDIVIDUAL      // Tek kullanıcı
  DEPARTMENT      // Departman
  MULTIPLE_DEPTS  // Birden fazla departman
  ORGANIZATION    // Tüm organizasyon
}

// Aciliyet
enum TicketUrgency {
  LOW             // Düşük - İş durmuyor
  MEDIUM          // Orta - Alternatif var
  HIGH            // Yüksek - İş aksaması
  URGENT          // Acil - Kritik müdahale
}

// Kaynak
enum TicketSource {
  WEB_PORTAL      // Web portalından
  EMAIL           // Email ile
  PHONE           // Telefon ile
  WALK_IN         // Yüz yüze
  CHAT            // Chat ile
  SYSTEM_AUTO     // Otomatik (monitoring vb.)
}

// Ticket Yorumları
model TicketComment {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorEmail String
  authorName  String
  content     String   @db.Text

  isInternal  Boolean  @default(false)  // Dahili not (kullanıcı göremez)
  isResolution Boolean @default(false)  // Çözüm notu mu?

  attachments String?  @db.Text         // JSON array

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ticketId])
  @@index([createdAt])
}

// Ticket Zaman Çizelgesi
model TicketTimeline {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  action      String            // "status_changed", "assigned", "comment_added"
  description String

  oldValue    String?           // Eski değer
  newValue    String?           // Yeni değer

  performedBy     String
  performedByName String

  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

// Çalışma Süreleri (Work Log)
model TicketWorkLog {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  technicianEmail String
  technicianName  String

  startTime   DateTime
  endTime     DateTime?
  duration    Int               // Dakika cinsinden

  workType    WorkLogType @default(REMOTE)
  description String   @db.Text

  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@index([technicianEmail])
}

enum WorkLogType {
  REMOTE          // Uzaktan destek
  ON_SITE         // Yerinde destek
  PHONE_SUPPORT   // Telefon desteği
  RESEARCH        // Araştırma
  DOCUMENTATION   // Dokümantasyon
}

// SLA Politikaları
model SLAPolicy {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String?

  // Öncelik bazlı SLA süreleri (dakika)
  lowResponseTime      Int   @default(480)   // 8 saat
  lowResolutionTime    Int   @default(2880)  // 48 saat

  normalResponseTime   Int   @default(240)   // 4 saat
  normalResolutionTime Int   @default(1440)  // 24 saat

  highResponseTime     Int   @default(60)    // 1 saat
  highResolutionTime   Int   @default(480)   // 8 saat

  criticalResponseTime Int   @default(15)    // 15 dakika
  criticalResolutionTime Int @default(120)   // 2 saat

  // Çalışma saatleri dahil mi?
  businessHoursOnly    Boolean @default(true)

  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

// Bilgi Bankası (Knowledge Base)
model KnowledgeArticle {
  id            String   @id @default(cuid())
  articleNumber String   @unique  // KB-0001

  title         String
  summary       String   @db.Text
  content       String   @db.Text  // HTML/Markdown

  // Kategorileme
  categoryId    String?
  tags          String[] @default([])

  // İlişkili Ticket Tipleri
  relatedTicketTypes String[] @default([])

  // Görünürlük
  visibility    ArticleVisibility @default(PUBLIC)

  // İstatistikler
  viewCount       Int @default(0)
  helpfulCount    Int @default(0)
  notHelpfulCount Int @default(0)

  // Yazar
  authorEmail   String
  authorName    String

  // Durum
  status        ArticleStatus @default(DRAFT)
  publishedAt   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([categoryId])
}

enum ArticleVisibility {
  PUBLIC          // Herkes görebilir
  INTERNAL        // Sadece IT ekibi
  RESTRICTED      // Belirli roller
}

enum ArticleStatus {
  DRAFT           // Taslak
  REVIEW          // İncelemede
  PUBLISHED       // Yayında
  ARCHIVED        // Arşivlenmiş
}

// ==========================================
// Tezgah Bakım ve Arıza Takip Modülü (CMMS)
// ==========================================

// Makine/Tezgah Tanımları
model Machine {
  id              String   @id @default(cuid())
  machineCode     String   @unique  // TZG-001, CNC-002 gibi
  name            String              // Makine adı
  description     String?  @db.Text

  // Makine Bilgileri
  machineType     MachineType @default(CNC)
  manufacturer    String?             // Üretici
  model           String?             // Model
  serialNumber    String?             // Seri numarası
  yearOfManufacture Int?              // Üretim yılı
  purchaseDate    DateTime?           // Satın alma tarihi
  warrantyEndDate DateTime?           // Garanti bitiş tarihi

  // Lokasyon
  location        String?             // Fabrika, Bina
  area            String?             // Alan/Hat
  department      String?             // Departman

  // Sorumlu
  responsibleEmail String?
  responsibleName String?

  // Teknik Özellikler (JSON)
  specifications  String?  @db.Text   // JSON: güç, boyut, kapasite vb.

  // Durum
  status          MachineStatus @default(ACTIVE)
  criticalityLevel MachineCriticality @default(B)  // ABC analizi

  // Çalışma bilgileri
  operatingHoursCounter Int @default(0)  // Toplam çalışma saati
  lastOperatingHoursUpdate DateTime?

  // Görsel
  imageUrl        String?
  qrCode          String?             // QR kod URL (hızlı arıza bildirimi için)

  // Metadata
  isActive        Boolean  @default(true)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // İlişkiler
  maintenancePlans    MaintenancePlan[]
  workOrders          MaintenanceWorkOrder[]
  downtimeRecords     DowntimeRecord[]
  spareParts          MachineSparePartUsage[]
  documents           MachineDocument[]
  oeeRecords          MachineOEERecord[]

  @@index([status])
  @@index([machineCode])
  @@index([machineType])
  @@index([department])
  @@index([criticalityLevel])
}

// Makine Tipleri
enum MachineType {
  CNC               // CNC Tezgah
  LATHE             // Torna
  MILLING           // Freze
  DRILLING          // Matkap
  GRINDING          // Taşlama
  PRESS             // Pres
  INJECTION         // Enjeksiyon
  ASSEMBLY          // Montaj Hattı
  CONVEYOR          // Konveyör
  PACKAGING         // Paketleme
  WELDING           // Kaynak
  CUTTING           // Kesim
  TESTING           // Test Ekipmanı
  UTILITY           // Yardımcı (Kompresör, vb.)
  OTHER             // Diğer
}

// Makine Durumları
enum MachineStatus {
  ACTIVE            // Çalışıyor
  IDLE              // Boşta
  MAINTENANCE       // Bakımda
  BREAKDOWN         // Arızalı
  SETUP             // Ayar/Hazırlık
  RETIRED           // Hurdaya ayrılmış
}

// Kritiklik Seviyesi (ABC Analizi)
enum MachineCriticality {
  A                 // Kritik - Üretim durur
  B                 // Önemli - Üretim azalır
  C                 // Normal - Alternatif var
}

// Bakım Planları (Periyodik Bakım)
model MaintenancePlan {
  id              String   @id @default(cuid())
  planCode        String   @unique  // BKM-001
  name            String
  description     String?  @db.Text

  // İlişkili Makine
  machineId       String
  machine         Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  // Bakım Tipi
  maintenanceType MaintenanceType @default(PREVENTIVE)

  // Periyot - Daha esnek yapı
  frequencyType   String   @default("TIME_BASED")  // TIME_BASED, HOURS_BASED, CYCLES_BASED
  frequencyValue  Int      @default(30)            // Periyot değeri
  frequencyUnit   String   @default("DAYS")        // DAYS, WEEKS, MONTHS, HOURS, CYCLES

  // Kontrol Listesi (JSON array)
  checklistItems  String?  @db.Text   // JSON: [{item, description, required}]
  requiredParts   String?  @db.Text   // JSON: Gerekli yedek parçalar

  // Talimatlar
  instructions    String?  @db.Text
  safetyNotes     String?  @db.Text

  // Tahmini süre ve maliyet
  estimatedDurationMinutes Int?       // Dakika cinsinden
  estimatedCost   Float?

  // Sorumlu ekip/kişi
  assignedTeam    String?
  assignedTo      String?             // Email
  assignedToName  String?

  // Son ve sonraki bakım
  lastPerformedAt DateTime?
  nextDueAt       DateTime?
  executionCount  Int      @default(0)  // Kaç kez yapıldı

  // Durum
  status          String   @default("ACTIVE")  // ACTIVE, PAUSED, RETIRED
  isActive        Boolean  @default(true)
  createdBy       String?
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // İlişkiler
  workOrders      MaintenanceWorkOrder[]

  @@index([machineId])
  @@index([nextDueAt])
  @@index([maintenanceType])
  @@index([status])
}

// Bakım Tipleri
enum MaintenanceType {
  PREVENTIVE        // Önleyici Bakım
  PREDICTIVE        // Kestirimci Bakım
  CORRECTIVE        // Düzeltici Bakım (Arıza sonrası)
  CONDITION_BASED   // Durum Bazlı Bakım
  INSPECTION        // Muayene/Kontrol
}

// Not: MaintenanceFrequency enum kaldırıldı, esnek string bazlı sistem kullanılıyor

// İş Emirleri (Work Orders)
model MaintenanceWorkOrder {
  id              String   @id @default(cuid())
  workOrderNumber String   @unique  // WO-2025-0001

  // İlişkili Makine
  machineId       String
  machine         Machine  @relation(fields: [machineId], references: [id])

  // İlişkili Bakım Planı (opsiyonel - planlı bakımlar için)
  maintenancePlanId String?
  maintenancePlan MaintenancePlan? @relation(fields: [maintenancePlanId], references: [id])

  // İş Emri Bilgileri
  title           String
  description     String   @db.Text
  workOrderType   WorkOrderType @default(BREAKDOWN)

  // Öncelik
  priority        WorkOrderPriority @default(NORMAL)

  // Durum
  status          WorkOrderStatus @default(OPEN)

  // Bildiren
  reportedBy      String
  reportedByName  String
  reportedAt      DateTime @default(now())

  // Arıza Bilgileri (Arıza iş emri ise)
  failureCode     String?            // Arıza kodu
  failureType     FailureType?       // Arıza tipi
  failureSymptom  String?  @db.Text  // Arıza belirtisi

  // Atama
  assignedTo      String?
  assignedToName  String?
  assignedTeam    String?
  assignedAt      DateTime?

  // Zaman Bilgileri
  scheduledStartAt DateTime?          // Planlanan başlangıç
  scheduledEndAt   DateTime?          // Planlanan bitiş
  actualStartAt    DateTime?          // Gerçek başlangıç
  actualEndAt      DateTime?          // Gerçek bitiş

  // Tamamlanma
  completedBy     String?
  completedByName String?
  completionNotes String?  @db.Text   // Yapılan işlemler
  rootCause       String?  @db.Text   // Kök neden

  // Maliyet
  laborCost       Float?              // İşçilik maliyeti
  partsCost       Float?              // Yedek parça maliyeti
  totalCost       Float?              // Toplam maliyet

  // Dosya Ekleri
  attachments     String?  @db.Text   // JSON array

  // Metadata
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // İlişkiler
  downtimeRecords DowntimeRecord[]
  sparePartsUsed  MachineSparePartUsage[]
  laborLogs       MaintenanceLaborLog[]
  timeline        MaintenanceTimeline[]

  @@index([machineId])
  @@index([status])
  @@index([workOrderType])
  @@index([priority])
  @@index([workOrderNumber])
  @@index([assignedTo])
  @@index([scheduledStartAt])
}

// İş Emri Tipleri
enum WorkOrderType {
  BREAKDOWN         // Arıza (Reaktif)
  PREVENTIVE        // Önleyici Bakım
  PREDICTIVE        // Kestirimci Bakım
  INSPECTION        // Muayene
  IMPROVEMENT       // İyileştirme
  INSTALLATION      // Kurulum
  CALIBRATION       // Kalibrasyon
  CLEANING          // Temizlik
}

// İş Emri Öncelikleri
enum WorkOrderPriority {
  CRITICAL          // Kritik - Hemen müdahale
  HIGH              // Yüksek - 2 saat içinde
  NORMAL            // Normal - 8 saat içinde
  LOW               // Düşük - Planlı bakımda
  SCHEDULED         // Zamanlanmış
}

// İş Emri Durumları
enum WorkOrderStatus {
  OPEN              // Açık - Yeni oluşturuldu
  ASSIGNED          // Atandı
  IN_PROGRESS       // Devam Ediyor
  ON_HOLD           // Beklemede (parça bekleniyor vb.)
  COMPLETED         // Tamamlandı
  CLOSED            // Kapatıldı (onaylandı)
  CANCELLED         // İptal
}

// Arıza Tipleri
enum FailureType {
  MECHANICAL        // Mekanik
  ELECTRICAL        // Elektrik
  ELECTRONIC        // Elektronik
  HYDRAULIC         // Hidrolik
  PNEUMATIC         // Pnömatik
  SOFTWARE          // Yazılım
  OPERATOR_ERROR    // Operatör Hatası
  WEAR              // Aşınma
  UNKNOWN           // Bilinmiyor
}

// Duruş Kayıtları
model DowntimeRecord {
  id              String   @id @default(cuid())

  // İlişkiler
  machineId       String
  machine         Machine  @relation(fields: [machineId], references: [id])
  workOrderId     String?
  workOrder       MaintenanceWorkOrder? @relation(fields: [workOrderId], references: [id])

  // Duruş Bilgileri
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int?                // Hesaplanan süre (dakika)

  // Duruş Tipi
  downtimeType    DowntimeType @default(BREAKDOWN)
  downtimeReason  String?             // Kısa açıklama

  // Üretim Kaybı
  plannedProduction Int?              // Planlanan üretim (adet)
  lostProduction    Int?              // Kaybedilen üretim (adet)

  // Kayıt eden
  recordedBy      String
  recordedByName  String

  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([machineId])
  @@index([workOrderId])
  @@index([startTime])
  @@index([downtimeType])
}

// Duruş Tipleri
enum DowntimeType {
  BREAKDOWN         // Arıza
  PLANNED           // Planlı Bakım
  SETUP             // Ayar/Hazırlık
  CHANGEOVER        // Ürün Değişimi
  NO_MATERIAL       // Malzeme Bekleme
  NO_OPERATOR       // Operatör Yok
  QUALITY_ISSUE     // Kalite Sorunu
  POWER_OUTAGE      // Elektrik Kesintisi
  OTHER             // Diğer
}

// Yedek Parça Tanımları
model SparePart {
  id              String   @id @default(cuid())
  partCode        String   @unique   // YP-0001
  name            String
  description     String?

  // Kategori
  category        String?             // Elektrik, Mekanik, vb.

  // Tedarik Bilgileri
  manufacturer    String?
  supplierPartNo  String?             // Tedarikçi parça numarası
  supplierName    String?
  unitPrice       Float?
  currency        String   @default("TRY")

  // Stok Bilgileri
  stockQuantity   Int      @default(0)
  minStockLevel   Int      @default(0)  // Minimum stok seviyesi
  maxStockLevel   Int?                   // Maksimum stok seviyesi
  reorderPoint    Int?                   // Yeniden sipariş noktası
  stockLocation   String?                // Depo lokasyonu

  // Birim
  unit            String   @default("Adet") // Adet, Metre, Litre, vb.

  // Kritiklik
  isCritical      Boolean  @default(false)

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // İlişkiler
  usageRecords    MachineSparePartUsage[]

  @@index([partCode])
  @@index([category])
  @@index([stockQuantity])
}

// Yedek Parça Kullanım Kaydı
model MachineSparePartUsage {
  id              String   @id @default(cuid())

  machineId       String
  machine         Machine  @relation(fields: [machineId], references: [id])
  workOrderId     String?
  workOrder       MaintenanceWorkOrder? @relation(fields: [workOrderId], references: [id])
  sparePartId     String
  sparePart       SparePart @relation(fields: [sparePartId], references: [id])

  quantity        Int
  unitCost        Float?
  totalCost       Float?

  usedBy          String
  usedByName      String
  usedAt          DateTime @default(now())

  notes           String?

  @@index([machineId])
  @@index([workOrderId])
  @@index([sparePartId])
  @@index([usedAt])
}

// İşçilik Kayıtları
model MaintenanceLaborLog {
  id              String   @id @default(cuid())
  workOrderId     String
  workOrder       MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  technicianEmail String
  technicianName  String

  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int?

  laborType       LaborType @default(REPAIR)
  hourlyRate      Float?
  totalCost       Float?

  description     String?  @db.Text

  createdAt       DateTime @default(now())

  @@index([workOrderId])
  @@index([technicianEmail])
}

// İşçilik Tipleri
enum LaborType {
  REPAIR            // Onarım
  INSPECTION        // Muayene
  PREVENTIVE        // Önleyici Bakım
  SETUP             // Ayar
  TRAINING          // Eğitim
  TRAVEL            // Seyahat
}

// Bakım Zaman Çizelgesi
model MaintenanceTimeline {
  id              String   @id @default(cuid())
  workOrderId     String
  workOrder       MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  action          String
  description     String
  oldValue        String?
  newValue        String?

  performedBy     String
  performedByName String

  createdAt       DateTime @default(now())

  @@index([workOrderId])
  @@index([createdAt])
}

// Makine Belgeleri
model MachineDocument {
  id              String   @id @default(cuid())
  machineId       String
  machine         Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  title           String
  documentType    MachineDocType @default(MANUAL)
  fileUrl         String
  fileName        String
  fileSize        Int?

  uploadedBy      String
  uploadedByName  String
  createdAt       DateTime @default(now())

  @@index([machineId])
  @@index([documentType])
}

// Belge Tipleri
enum MachineDocType {
  MANUAL            // Kullanım Kılavuzu
  MAINTENANCE       // Bakım Talimatı
  SPARE_PARTS       // Yedek Parça Listesi
  DRAWING           // Teknik Çizim
  CERTIFICATE       // Sertifika
  WARRANTY          // Garanti Belgesi
  OTHER             // Diğer
}

// OEE Kayıtları (Günlük/Vardiya bazlı)
model MachineOEERecord {
  id              String   @id @default(cuid())
  machineId       String
  machine         Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  recordDate      DateTime
  shift           String?             // Vardiya (A, B, C)

  // Süre Bilgileri (dakika)
  plannedProductionTime Int           // Planlanan üretim süresi
  actualRunTime         Int           // Gerçek çalışma süresi
  downtime              Int  @default(0)  // Toplam duruş

  // Üretim Bilgileri
  plannedOutput   Int                 // Planlanan üretim
  actualOutput    Int                 // Gerçek üretim
  defectCount     Int  @default(0)    // Hatalı ürün

  // OEE Bileşenleri (%)
  availability    Float               // Kullanılabilirlik
  performance     Float               // Performans
  quality         Float               // Kalite
  oee             Float               // OEE (A x P x Q)

  // Kayıt eden
  recordedBy      String
  recordedByName  String

  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  @@unique([machineId, recordDate, shift])
  @@index([machineId])
  @@index([recordDate])
}

// Bakım KPI Hedefleri
model MaintenanceKPITarget {
  id              String   @id @default(cuid())
  year            Int
  month           Int?                // null ise yıllık hedef

  // Hedef KPI'lar
  targetOEE       Float?              // Hedef OEE (%)
  targetMTBF      Float?              // Hedef MTBF (saat)
  targetMTTR      Float?              // Hedef MTTR (saat)
  targetPMCompliance Float?           // Planlı bakım uyum oranı (%)
  targetDowntime  Float?              // Maksimum duruş süresi (%)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([year, month])
  @@index([year])
}

// =============================================================================
// QDMS - Kalite Doküman Yönetim Sistemi
// =============================================================================

// Doküman Kategorileri
enum QdmsDocumentCategory {
  PROCEDURE        // Prosedür
  INSTRUCTION      // Talimat
  FORM             // Form
  SPECIFICATION    // Şartname
  MANUAL           // El Kitabı
  POLICY           // Politika
  RECORD           // Kayıt
  EXTERNAL         // Dış Kaynaklı Doküman
  TEMPLATE         // Şablon
  OTHER            // Diğer
}

// Doküman Durumu
enum QdmsDocumentStatus {
  DRAFT            // Taslak
  PENDING_REVIEW   // İnceleme Bekliyor
  PENDING_APPROVAL // Onay Bekliyor
  APPROVED         // Onaylandı
  PUBLISHED        // Yayınlandı
  OBSOLETE         // Geçersiz/İptal
  ARCHIVED         // Arşivlendi
}

// Onay Durumu
enum QdmsApprovalStatus {
  PENDING          // Bekliyor
  APPROVED         // Onaylandı
  REJECTED         // Reddedildi
  REVISION_REQUESTED // Revizyon İstendi
}

// CAPA Türü
enum QdmsCapaType {
  CORRECTIVE       // Düzeltici Faaliyet
  PREVENTIVE       // Önleyici Faaliyet
  BOTH             // Her İkisi
}

// CAPA Durumu
enum QdmsCapaStatus {
  OPEN             // Açık
  IN_PROGRESS      // Devam Ediyor
  PENDING_VERIFICATION // Doğrulama Bekliyor
  CLOSED           // Kapatıldı
  CANCELLED        // İptal Edildi
}

// CAPA Öncelik
enum QdmsCapaPriority {
  LOW              // Düşük
  MEDIUM           // Orta
  HIGH             // Yüksek
  CRITICAL         // Kritik
}

// Uygunsuzluk Seviyesi
enum QdmsNonConformanceLevel {
  MINOR            // Minör
  MAJOR            // Majör
  CRITICAL         // Kritik
}

// Denetim Türü
enum QdmsAuditType {
  INTERNAL         // İç Denetim
  EXTERNAL         // Dış Denetim
  SUPPLIER         // Tedarikçi Denetimi
  CUSTOMER         // Müşteri Denetimi
  CERTIFICATION    // Belgelendirme Denetimi
}

// Denetim Durumu
enum QdmsAuditStatus {
  PLANNED          // Planlandı
  IN_PROGRESS      // Devam Ediyor
  COMPLETED        // Tamamlandı
  CANCELLED        // İptal Edildi
}

// Risk Seviyesi
enum QdmsRiskLevel {
  VERY_LOW         // Çok Düşük
  LOW              // Düşük
  MEDIUM           // Orta
  HIGH             // Yüksek
  VERY_HIGH        // Çok Yüksek
}

// Tedarikçi Durumu
enum QdmsSupplierStatus {
  PENDING          // Değerlendirme Bekliyor
  APPROVED         // Onaylı
  CONDITIONAL      // Şartlı Onaylı
  SUSPENDED        // Askıya Alındı
  BLACKLISTED      // Kara Liste
}

// Değişiklik Talebi Durumu
enum QdmsChangeRequestStatus {
  DRAFT            // Taslak
  SUBMITTED        // Gönderildi
  UNDER_REVIEW     // İnceleniyor
  APPROVED         // Onaylandı
  REJECTED         // Reddedildi
  IMPLEMENTED      // Uygulandı
  CLOSED           // Kapatıldı
}

// Eğitim Durumu
enum QdmsTrainingStatus {
  NOT_STARTED      // Başlamadı
  IN_PROGRESS      // Devam Ediyor
  COMPLETED        // Tamamlandı
  FAILED           // Başarısız
  EXPIRED          // Süresi Doldu
}

// =============================================================================
// DOKÜMAN YÖNETİMİ
// =============================================================================

// Ana Doküman Tablosu
model QdmsDocument {
  id              String   @id @default(cuid())
  
  // Doküman Kimliği
  documentNumber  String   @unique          // Doküman No (örn: PR-QMS-001)
  title           String                    // Doküman Başlığı
  description     String?  @db.Text         // Açıklama
  
  // Sınıflandırma
  category        QdmsDocumentCategory      // Kategori
  departmentId    String?                   // İlgili Departman
  department      Department? @relation(fields: [departmentId], references: [id])
  
  // Versiyon Bilgisi
  version         String   @default("1.0")  // Mevcut Versiyon
  revisionNumber  Int      @default(0)      // Revizyon Sayısı
  status          QdmsDocumentStatus @default(DRAFT)
  
  // Dosya Bilgisi
  fileName        String?                   // Dosya adı
  fileUrl         String?                   // Dosya URL
  fileSize        Int?                      // Dosya boyutu (bytes)
  mimeType        String?                   // MIME tipi
  
  // Geçerlilik
  effectiveDate   DateTime?                 // Yürürlük Tarihi
  expiryDate      DateTime?                 // Geçerlilik Bitiş
  reviewDate      DateTime?                 // Sonraki Gözden Geçirme Tarihi
  reviewPeriodMonths Int @default(12)       // Gözden Geçirme Periyodu (ay)
  
  // Sorumlular
  ownerId         String                    // Doküman Sahibi
  owner           User     @relation("DocumentOwner", fields: [ownerId], references: [id])
  createdById     String                    // Oluşturan
  createdBy       User     @relation("DocumentCreator", fields: [createdById], references: [id])
  
  // İlişkiler
  revisions       QdmsDocumentRevision[]
  approvals       QdmsDocumentApproval[]
  distributions   QdmsDocumentDistribution[]
  trainings       QdmsTrainingRecord[]
  linkedCapas     QdmsCapa[]                @relation("CapaDocuments")
  linkedAudits    QdmsAuditFinding[]        @relation("AuditFindingDocuments")
  changeRequests  QdmsChangeRequest[]       @relation("ChangeRequestDocuments")
  
  // Meta
  tags            String[]                  // Etiketler
  isConfidential  Boolean  @default(false)  // Gizli Doküman
  isControlledCopy Boolean @default(true)   // Kontrollü Kopya
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publishedAt     DateTime?
  archivedAt      DateTime?
  
  @@index([documentNumber])
  @@index([category])
  @@index([status])
  @@index([departmentId])
  @@index([ownerId])
}

// Doküman Revizyonları
model QdmsDocumentRevision {
  id              String   @id @default(cuid())
  documentId      String
  document        QdmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  version         String                    // Versiyon (1.0, 1.1, 2.0)
  revisionNumber  Int                       // Revizyon No
  changeDescription String @db.Text         // Değişiklik Açıklaması
  
  // Dosya
  fileName        String?
  fileUrl         String?
  fileSize        Int?
  
  // Revizyon Yapan
  revisedById     String
  revisedBy       User     @relation(fields: [revisedById], references: [id])
  
  createdAt       DateTime @default(now())
  
  @@index([documentId])
  @@index([version])
}

// Doküman Onay İş Akışı
model QdmsDocumentApproval {
  id              String   @id @default(cuid())
  documentId      String
  document        QdmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Onay Sırası
  stepOrder       Int                       // Onay sırası (1, 2, 3...)
  stepName        String                    // Adım adı (Hazırlayan, Kontrol, Onay)

  // Onaylayıcı
  approverId      String
  approver        User     @relation(fields: [approverId], references: [id])

  // Durum
  status          QdmsApprovalStatus @default(PENDING)
  comments        String?  @db.Text         // Yorum
  signature       String?                   // E-imza (hash)

  // Dijital İmza Doğrulama Bilgileri
  signatureHash       String?               // SHA-256 hash (belge + onay bilgisi)
  signatureTimestamp  DateTime?             // İmza zaman damgası
  signerIpAddress     String?               // İmzalayan IP adresi
  signerUserAgent     String?               // İmzalayan tarayıcı bilgisi
  verificationCode    String?   @unique     // QR kod doğrulama kodu (UUID)

  // Tarihler
  dueDate         DateTime?                 // Son Onay Tarihi
  actionDate      DateTime?                 // İşlem Tarihi

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([documentId])
  @@index([approverId])
  @@index([status])
  @@index([verificationCode])
}

// Doküman Dağıtım Kaydı
model QdmsDocumentDistribution {
  id              String   @id @default(cuid())
  documentId      String
  document        QdmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  // Dağıtım Hedefi
  userId          String?                   // Kişiye dağıtım
  user            User?    @relation(fields: [userId], references: [id])
  departmentId    String?                   // Departmana dağıtım
  department      Department? @relation(fields: [departmentId], references: [id])
  
  // Kopya Bilgisi
  copyNumber      String?                   // Kopya No
  isControlled    Boolean  @default(true)   // Kontrollü kopya
  
  // Alındı Teyidi
  acknowledged    Boolean  @default(false)  // Alındı onayı
  acknowledgedAt  DateTime?
  
  distributedAt   DateTime @default(now())
  
  @@index([documentId])
  @@index([userId])
  @@index([departmentId])
}

// =============================================================================
// CAPA - Düzeltici ve Önleyici Faaliyetler
// =============================================================================

model QdmsCapa {
  id              String   @id @default(cuid())
  
  // CAPA Kimliği
  capaNumber      String   @unique          // CAPA No (örn: CAPA-2024-001)
  title           String                    // Başlık
  description     String   @db.Text         // Açıklama
  
  // Sınıflandırma
  type            QdmsCapaType              // Düzeltici/Önleyici
  priority        QdmsCapaPriority          // Öncelik
  status          QdmsCapaStatus @default(OPEN)
  
  // Kaynak
  sourceType      String                    // Kaynak türü (Audit, Complaint, NCR, etc.)
  sourceId        String?                   // Kaynak ID
  sourceReference String?                   // Kaynak referansı
  
  // Departman
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  
  // Sorumlular
  initiatorId     String                    // Açan kişi
  initiator       User     @relation("CapaInitiator", fields: [initiatorId], references: [id])
  responsibleId   String                    // Sorumlu
  responsible     User     @relation("CapaResponsible", fields: [responsibleId], references: [id])
  
  // Analiz
  rootCause       String?  @db.Text         // Kök Neden
  rootCauseMethod String?                   // Kök Neden Analiz Yöntemi (5 Why, Fishbone)
  immediateAction String?  @db.Text         // Acil Aksiyon
  
  // Aksiyon Planı
  plannedActions  String?  @db.Text         // Planlanan Aksiyonlar
  dueDate         DateTime?                 // Hedef Tamamlanma
  completedDate   DateTime?                 // Gerçek Tamamlanma
  
  // Doğrulama
  verificationMethod String? @db.Text       // Doğrulama Yöntemi
  verificationResult String? @db.Text       // Doğrulama Sonucu
  verifiedById    String?
  verifiedBy      User?    @relation("CapaVerifier", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?
  
  // Etkinlik
  effectivenessCheck Boolean @default(false)
  effectivenessResult String? @db.Text
  effectivenessDate DateTime?
  
  // İlişkiler
  actions         QdmsCapaAction[]
  documents       QdmsDocument[] @relation("CapaDocuments")
  nonConformances QdmsNonConformance[]
  auditFindings   QdmsAuditFinding[]
  customerComplaints QdmsCustomerComplaint[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  closedAt        DateTime?

  @@index([capaNumber])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([departmentId])
  @@index([responsibleId])
}

// CAPA Aksiyonları
model QdmsCapaAction {
  id              String   @id @default(cuid())
  capaId          String
  capa            QdmsCapa @relation(fields: [capaId], references: [id], onDelete: Cascade)
  
  // Aksiyon Detayı
  actionNumber    Int                       // Aksiyon sırası
  description     String   @db.Text         // Aksiyon açıklaması
  
  // Sorumlu ve Tarihler
  responsibleId   String
  responsible     User     @relation(fields: [responsibleId], references: [id])
  dueDate         DateTime
  completedDate   DateTime?
  
  // Durum
  status          QdmsCapaStatus @default(OPEN)
  completionNotes String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([capaId])
  @@index([responsibleId])
  @@index([status])
}

// =============================================================================
// UYGUNSUZLUK YÖNETİMİ
// =============================================================================

model QdmsNonConformance {
  id              String   @id @default(cuid())
  
  // NCR Kimliği
  ncrNumber       String   @unique          // NCR No (örn: NCR-2024-001)
  title           String
  description     String   @db.Text
  
  // Sınıflandırma
  level           QdmsNonConformanceLevel
  category        String?                   // Uygunsuzluk kategorisi
  
  // Tespit Bilgisi
  detectedAt      DateTime                  // Tespit tarihi
  detectedById    String                    // Tespit eden
  detectedBy      User     @relation("NCRDetector", fields: [detectedById], references: [id])
  detectedArea    String?                   // Tespit yeri
  
  // Etkilenen
  productId       String?                   // Etkilenen ürün
  batchNumber     String?                   // Parti no

// =====================================================
// YEDEKLEME YÖNETİMİ (Backup Management)
// =====================================================

// Yedekleme Logu
model BackupLog {
  id           String       @id @default(cuid())
  backupName   String // ilerihub_20260107_123456.tar.gz
  backupType   BackupType
  projectName  String // ILERIHub, Akademi, Database, All
  filePath     String
  fileSize     BigInt       @default(0) // bytes
  status       BackupStatus @default(PENDING)
  errorMessage String?      @db.Text

  // Ayarlar
  includeDatabase Boolean @default(false)
  excludePatterns String? // node_modules,.git,.next

  // Zamanlar
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  duration    Int? // saniye

  // Kim yaptı
  createdBy     String
  createdByName String

  // Metadata
  serverIp String?
  notes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([projectName])
  @@index([backupType])
  @@index([createdAt])
}

// Zamanlanmış Yedekleme
model BackupSchedule {
  id              String          @id @default(cuid())
  name            String
  projectName     String // ILERIHub, Akademi, Database, All
  frequency       BackupFrequency // DAILY, WEEKLY, MONTHLY
  time            String // "03:00"
  dayOfWeek       Int? // 0-6 (Pazar-Cumartesi)
  dayOfMonth      Int? // 1-31
  retentionDays   Int             @default(30)
  includeDatabase Boolean         @default(true)
  isActive        Boolean         @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  createdBy       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([nextRunAt])
}

// Yedekleme Tipi
enum BackupType {
  MANUAL // Manuel yedek
  SCHEDULED // Zamanlanmış yedek
  PRE_UPDATE // Güncelleme öncesi
  PRE_RESTORE // Geri yükleme öncesi
}

// Yedekleme Durumu
enum BackupStatus {
  PENDING // Bekliyor
  IN_PROGRESS // Devam ediyor
  COMPLETED // Tamamlandı
  FAILED // Başarısız
}

// Yedekleme Sıklığı
enum BackupFrequency {
  DAILY // Günlük
  WEEKLY // Haftalık
  MONTHLY // Aylık
}

// ==========================================
// Yemek Menüsü Sistemi
// ==========================================

// Günlük Yemek Menüsü
model DailyMenu {
  id          String   @id @default(cuid())
  date        DateTime @unique @db.Date // Tarih (YYYY-MM-DD)
  items       String[] // Yemek listesi (çorba, ana yemek, yan yemek, içecek vb.)
  isHoliday   Boolean  @default(false) // Tatil günü mü?
  holidayName String? // Tatil adı (Cumartesi, Pazar, Resmi Tatil vb.)
  notes       String? // Ekstra notlar

  createdBy     String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
}

// ==========================================
// YETENEK YÖNETİMİ (Talent Management)
// ==========================================

// Yetkinlik Tanımları
model Competency {
  id          String             @id @default(cuid())
  code        String             @unique // LEADERSHIP, COMMUNICATION, PROBLEM_SOLVING
  name        String // Liderlik, İletişim, Problem Çözme
  description String?            @db.Text
  category    CompetencyCategory // CORE, LEADERSHIP, TECHNICAL, BEHAVIORAL

  // Seviye tanımları (1-5)
  level1Desc String? @db.Text // Başlangıç
  level2Desc String? @db.Text // Gelişen
  level3Desc String? @db.Text // Yetkin
  level4Desc String? @db.Text // İleri
  level5Desc String? @db.Text // Uzman

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  // İlişkiler
  positionCompetencies PositionCompetency[]
  employeeCompetencies EmployeeCompetency[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

// Pozisyon Tanımları
model Position {
  id          String        @id @default(cuid())
  code        String        @unique // ENG-001, MGR-002
  title       String // Kıdemli Yazılım Mühendisi
  department  String // Yazılım Geliştirme
  level       PositionLevel // ENTRY, JUNIOR, MID, SENIOR, LEAD, MANAGER, DIRECTOR, EXECUTIVE
  description String?       @db.Text

  // Kaynak bilgisi
  source       PositionSource @default(MANUAL) // MANUAL veya AD
  adJobTitle   String? // AD'deki orijinal jobTitle değeri (senkronizasyon için)
  lastSyncedAt DateTime? // Son AD senkronizasyon zamanı

  // Kariyer yolu
  nextPositionId    String? // Bir üst pozisyon
  nextPosition      Position?  @relation("CareerPath", fields: [nextPositionId], references: [id])
  previousPositions Position[] @relation("CareerPath")

  // Gereksinimler
  minExperienceYears     Int      @default(0)
  requiredEducation      String? // Lisans, Yüksek Lisans vb.
  requiredCertifications String[] // ["PMP", "AWS"]

  isCritical Boolean @default(false) // Kritik pozisyon mu?
  isActive   Boolean @default(true)

  // İlişkiler
  requiredCompetencies PositionCompetency[]
  talentProfiles       TalentProfile[]
  successionPlans      SuccessionPlan[]
  careerPaths          CareerPath[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([level])
  @@index([isCritical])
  @@index([source])
  @@index([adJobTitle])
}

// Pozisyon için Gerekli Yetkinlikler
model PositionCompetency {
  id           String     @id @default(cuid())
  positionId   String
  position     Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id])

  requiredLevel Int // 1-5 gerekli seviye
  weight        Float   @default(1) // Ağırlık (önem derecesi)
  isMandatory   Boolean @default(true) // Zorunlu mu?

  createdAt DateTime @default(now())

  @@unique([positionId, competencyId])
  @@index([positionId])
}

// Yetenek Profili (Her çalışan için)
model TalentProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  userEmail  String  @unique
  userName   String
  department String?

  // Mevcut pozisyon
  currentPositionId String?
  currentPosition   Position? @relation(fields: [currentPositionId], references: [id])

  // Hesaplanan Skorlar
  talentScore      Float @default(0) // 0-100 arası genel skor
  performanceScore Float @default(0) // Performans skoru (öneri, kaizen vb.)
  potentialScore   Float @default(0) // Potansiyel skoru
  competencyScore  Float @default(0) // Yetkinlik ortalama skoru

  // 9-Box Grid
  performanceLevel PerformanceLevel @default(MEETING) // LOW, MEETING, EXCEEDING
  potentialLevel   PotentialLevel   @default(MEDIUM) // LOW, MEDIUM, HIGH
  nineBoxPosition  String? // "STAR", "HIGH_PERFORMER", "CORE_PLAYER" vb.

  // Risk ve Durum
  retentionRisk   RetentionRisk   @default(LOW) // LOW, MEDIUM, HIGH, CRITICAL
  engagementLevel EngagementLevel @default(ENGAGED) // DISENGAGED, NEUTRAL, ENGAGED, HIGHLY_ENGAGED

  // Etiketler
  tags String[] // ["İnovatör", "Lider Adayı", "Teknik Uzman"]

  // İşe giriş ve kıdem
  hireDate       DateTime? @db.Date
  yearsOfService Float? // Kıdem yılı

  // Son değerlendirme
  lastAssessedAt DateTime?
  lastAssessedBy String?

  // İlişkiler
  competencies     EmployeeCompetency[]
  developmentPlans DevelopmentPlan[]
  careerPaths      CareerPath[]
  mentorOf         MentorshipRelation[] @relation("Mentor")
  menteeOf         MentorshipRelation[] @relation("Mentee")

  // Yedekleme planlarında aday
  readyNowFor      SuccessionCandidate[] @relation("ReadyNow")
  readyIn1YearFor  SuccessionCandidate[] @relation("ReadyIn1Year")
  readyIn2YearsFor SuccessionCandidate[] @relation("ReadyIn2Years")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([performanceLevel, potentialLevel])
  @@index([retentionRisk])
  @@index([talentScore])
}

// Çalışan Yetkinlik Değerlendirmesi
model EmployeeCompetency {
  id              String        @id @default(cuid())
  talentProfileId String
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)
  competencyId    String
  competency      Competency    @relation(fields: [competencyId], references: [id])

  currentLevel Int // 1-5 mevcut seviye
  targetLevel  Int? // 1-5 hedef seviye
  gap          Int? // targetLevel - currentLevel

  // Değerlendirme
  selfAssessment    Int? // Öz değerlendirme
  managerAssessment Int? // Yönetici değerlendirmesi
  peerAssessment    Float? // Akran ortalaması

  // Notlar
  evidence         String? @db.Text // Kanıtlar, örnekler
  developmentNotes String? @db.Text // Gelişim notları

  lastAssessedAt DateTime @default(now())
  assessedBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([talentProfileId, competencyId])
  @@index([talentProfileId])
  @@index([gap])
}

// Yedekleme Planı (Succession Plan)
model SuccessionPlan {
  id         String   @id @default(cuid())
  positionId String
  position   Position @relation(fields: [positionId], references: [id])

  // Mevcut pozisyon sahibi
  currentHolderId    String?
  currentHolderEmail String?
  currentHolderName  String?

  // Plan durumu
  status   SuccessionStatus   @default(DRAFT) // DRAFT, ACTIVE, COMPLETED
  priority SuccessionPriority @default(MEDIUM) // LOW, MEDIUM, HIGH, CRITICAL

  // Risk değerlendirmesi
  vacancyRisk    VacancyRisk @default(LOW) // Boşalma riski
  impactIfVacant String?     @db.Text // Boşalırsa etki

  // Notlar
  notes String? @db.Text

  // Adaylar
  candidates SuccessionCandidate[]

  // Oluşturan
  createdBy     String
  createdByName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([positionId])
  @@index([status])
  @@index([priority])
}

// Yedekleme Adayları
model SuccessionCandidate {
  id               String         @id @default(cuid())
  successionPlanId String
  successionPlan   SuccessionPlan @relation(fields: [successionPlanId], references: [id], onDelete: Cascade)

  // Hazırlık durumu
  readiness ReadinessLevel // READY_NOW, READY_1_YEAR, READY_2_YEARS, DEVELOPMENTAL

  // İlişkiler
  readyNowProfileId String?
  readyNowProfile   TalentProfile? @relation("ReadyNow", fields: [readyNowProfileId], references: [id])

  readyIn1YearProfileId String?
  readyIn1YearProfile   TalentProfile? @relation("ReadyIn1Year", fields: [readyIn1YearProfileId], references: [id])

  readyIn2YearsProfileId String?
  readyIn2YearsProfile   TalentProfile? @relation("ReadyIn2Years", fields: [readyIn2YearsProfileId], references: [id])

  // Değerlendirme
  overallFit        Int? // 1-5 uygunluk
  strengthsForRole  String? @db.Text
  gapsForRole       String? @db.Text
  developmentNeeded String? @db.Text

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([successionPlanId])
  @@index([readiness])
}

// Kariyer Yolu
model CareerPath {
  id              String        @id @default(cuid())
  talentProfileId String
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  // Hedef pozisyon
  targetPositionId String
  targetPosition   Position @relation(fields: [targetPositionId], references: [id])

  // Planlama
  targetDate      DateTime? @db.Date
  estimatedMonths Int? // Tahmini süre (ay)

  // Durum
  status   CareerPathStatus @default(PLANNED) // PLANNED, IN_PROGRESS, ACHIEVED, CANCELLED
  progress Float            @default(0) // 0-100 ilerleme yüzdesi

  // Gereksinimler
  requiredTrainings      String[] // Gerekli eğitimler
  requiredCertifications String[] // Gerekli sertifikalar
  requiredExperience     String?  @db.Text // Gerekli deneyim

  // Notlar
  notes String? @db.Text

  // Onay
  approvedBy String?
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([talentProfileId])
  @@index([targetPositionId])
  @@index([status])
}

// Gelişim Planı
model DevelopmentPlan {
  id              String        @id @default(cuid())
  talentProfileId String
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  title       String // "2026 Liderlik Gelişim Planı"
  description String? @db.Text

  // Dönem
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  // Durum
  status   DevelopmentStatus @default(DRAFT) // DRAFT, ACTIVE, COMPLETED, CANCELLED
  progress Float             @default(0) // 0-100

  // Hedefler
  goals DevelopmentGoal[]

  // Onay
  approvedBy     String?
  approvedByName String?
  approvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([talentProfileId])
  @@index([status])
}

// Gelişim Hedefi
model DevelopmentGoal {
  id                String          @id @default(cuid())
  developmentPlanId String
  developmentPlan   DevelopmentPlan @relation(fields: [developmentPlanId], references: [id], onDelete: Cascade)

  title       String
  description String?             @db.Text
  category    DevelopmentCategory // TRAINING, EXPERIENCE, COACHING, PROJECT, CERTIFICATION

  // İlgili yetkinlik (opsiyonel)
  relatedCompetencyCode String?

  // Planlama
  targetDate DateTime? @db.Date

  // Durum
  status   GoalStatus @default(NOT_STARTED)
  progress Float      @default(0) // 0-100

  // Tamamlanma
  completedAt DateTime?
  evidence    String?   @db.Text // Kanıt/çıktı

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([developmentPlanId])
  @@index([status])
}

// Mentorluk İlişkisi
model MentorshipRelation {
  id String @id @default(cuid())

  mentorId String
  mentor   TalentProfile @relation("Mentor", fields: [mentorId], references: [id])

  menteeId String
  mentee   TalentProfile @relation("Mentee", fields: [menteeId], references: [id])

  // Dönem
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  // Odak alanı
  focusArea String? // "Liderlik", "Teknik", "Kariyer"
  goals     String? @db.Text

  // Durum
  status MentorshipStatus @default(ACTIVE) // ACTIVE, COMPLETED, CANCELLED

  // Değerlendirme
  mentorFeedback String? @db.Text
  menteeFeedback String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mentorId, menteeId])
  @@index([mentorId])
  @@index([menteeId])
  @@index([status])
}

// Yetenek Aktivite Logları
model TalentActivityLog {
  id           String             @id @default(cuid())
  activityType TalentActivityType

  // İlgili çalışan
  employeeId    String?
  employeeEmail String?
  employeeName  String?

  // Detay
  description String @db.Text
  metadata    Json? // Ekstra veriler

  // Kim yaptı
  performedBy     String
  performedByName String

  createdAt DateTime @default(now())

  @@index([activityType])
  @@index([employeeEmail])
  @@index([createdAt])
}

// ==========================================
// YETENEK YÖNETİMİ ENUM'LARI
// ==========================================

enum CompetencyCategory {
  CORE // Temel yetkinlikler
  LEADERSHIP // Liderlik yetkinlikleri
  TECHNICAL // Teknik yetkinlikler
  BEHAVIORAL // Davranışsal yetkinlikler
  FUNCTIONAL // Fonksiyonel yetkinlikler
}

enum PositionLevel {
  ENTRY // Giriş seviye
  JUNIOR // Junior
  MID // Orta seviye
  SENIOR // Kıdemli
  LEAD // Takım lideri
  MANAGER // Yönetici
  DIRECTOR // Direktör
  EXECUTIVE // Üst yönetim
}

enum PositionSource {
  MANUAL // Manuel olarak eklendi
  AD // Active Directory'den senkronize edildi
}

enum PerformanceLevel {
  LOW // Düşük performans
  MEETING // Beklentiyi karşılıyor
  EXCEEDING // Beklentiyi aşıyor
}

enum PotentialLevel {
  LOW // Düşük potansiyel
  MEDIUM // Orta potansiyel
  HIGH // Yüksek potansiyel
}

enum RetentionRisk {
  LOW // Düşük risk
  MEDIUM // Orta risk
  HIGH // Yüksek risk
  CRITICAL // Kritik risk
}

enum EngagementLevel {
  DISENGAGED // Bağlılık yok
  NEUTRAL // Nötr
  ENGAGED // Bağlı
  HIGHLY_ENGAGED // Yüksek bağlılık
}

enum SuccessionStatus {
  DRAFT // Taslak
  ACTIVE // Aktif
  COMPLETED // Tamamlandı
}

enum SuccessionPriority {
  LOW // Düşük öncelik
  MEDIUM // Orta öncelik
  HIGH // Yüksek öncelik
  CRITICAL // Kritik
}

enum VacancyRisk {
  LOW // Düşük boşalma riski
  MEDIUM // Orta
  HIGH // Yüksek
  IMMINENT // Yakın zamanda boşalacak
}

enum ReadinessLevel {
  READY_NOW // Şimdi hazır
  READY_1_YEAR // 1 yıl içinde hazır
  READY_2_YEARS // 2 yıl içinde hazır
  DEVELOPMENTAL // Gelişim aşamasında
}

enum CareerPathStatus {
  PLANNED // Planlandı
  IN_PROGRESS // Devam ediyor
  ACHIEVED // Ulaşıldı
  CANCELLED // İptal edildi
}

enum DevelopmentStatus {
  DRAFT // Taslak
  ACTIVE // Aktif
  COMPLETED // Tamamlandı
  CANCELLED // İptal edildi
}

enum DevelopmentCategory {
  TRAINING // Eğitim
  EXPERIENCE // İş deneyimi
  COACHING // Koçluk
  PROJECT // Proje
  CERTIFICATION // Sertifikasyon
  MENTORING // Mentorluk
  SHADOWING // Gözlem/takip
}

enum GoalStatus {
  NOT_STARTED // Başlamadı
  IN_PROGRESS // Devam ediyor
  ACHIEVED // Gerçekleşti
  PARTIALLY // Kısmen gerçekleşti
  NOT_ACHIEVED // Gerçekleşmedi
}

enum MentorshipStatus {
  ACTIVE // Aktif
  COMPLETED // Tamamlandı
  CANCELLED // İptal edildi
}

enum TalentActivityType {
  PROFILE_CREATED // Profil oluşturuldu
  PROFILE_UPDATED // Profil güncellendi
  COMPETENCY_ASSESSED // Yetkinlik değerlendirildi
  TALENT_SCORE_UPDATED // Yetenek skoru güncellendi
  CAREER_PATH_CREATED // Kariyer yolu oluşturuldu
  DEVELOPMENT_PLAN_CREATED // Gelişim planı oluşturuldu
  DEVELOPMENT_GOAL_COMPLETED // Gelişim hedefi tamamlandı
  SUCCESSION_PLAN_CREATED // Yedekleme planı oluşturuldu
  MENTORSHIP_STARTED // Mentorluk başladı
  MENTORSHIP_COMPLETED // Mentorluk tamamlandı
  NINE_BOX_UPDATED // 9-Box güncellendi
  TAG_ADDED // Etiket eklendi
  TAG_REMOVED // Etiket kaldırıldı
}

// ==========================================
// PERFORMANS YÖNETİMİ (Performance Management)
// ==========================================

// Performans Döngüsü (Yıllık/Dönemsel)
model PerformanceCycle {
  id          String  @id @default(cuid())
  name        String // "2026 Yıllık Performans Değerlendirmesi"
  description String? @db.Text

  // Dönem
  year      Int // 2026
  cycleType CycleType // ANNUAL, SEMI_ANNUAL, QUARTERLY
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date

  // Aşamalar
  goalSettingStart   DateTime? @db.Date
  goalSettingEnd     DateTime? @db.Date
  midYearReviewStart DateTime? @db.Date
  midYearReviewEnd   DateTime? @db.Date
  yearEndReviewStart DateTime? @db.Date
  yearEndReviewEnd   DateTime? @db.Date
  calibrationStart   DateTime? @db.Date
  calibrationEnd     DateTime? @db.Date

  // Durum
  status   PerformanceCycleStatus @default(DRAFT)
  isActive Boolean                @default(false)

  // Değerlendirmeler
  reviews PerformanceReview[]

  createdBy     String
  createdByName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year])
  @@index([status])
  @@index([isActive])
}

// Bireysel Performans Değerlendirmesi
model PerformanceReview {
  id      String           @id @default(cuid())
  cycleId String
  cycle   PerformanceCycle @relation(fields: [cycleId], references: [id])

  // Değerlendirilen çalışan
  employeeId         String
  employeeEmail      String
  employeeName       String
  employeeDepartment String?

  // Yönetici
  managerId    String?
  managerEmail String?
  managerName  String?

  // Hedefler
  goals PerformanceGoal[]

  // Değerlendirme skorları
  goalScore       Float? // Hedef gerçekleştirme skoru (0-100)
  competencyScore Float? // Yetkinlik skoru (0-100)
  overallScore    Float? // Genel skor (0-100)

  // Puanlama
  goalRating       PerformanceRating? // Hedef puanı
  competencyRating PerformanceRating? // Yetkinlik puanı
  overallRating    PerformanceRating? // Genel puan

  // Öz değerlendirme
  selfAssessmentCompleted Boolean   @default(false)
  selfAssessmentDate      DateTime?
  selfComments            String?   @db.Text

  // Yönetici değerlendirmesi
  managerAssessmentCompleted Boolean   @default(false)
  managerAssessmentDate      DateTime?
  managerComments            String?   @db.Text

  // Kalibrasyon
  calibratedRating PerformanceRating? // Kalibrasyon sonrası
  calibrationNotes String?            @db.Text

  // Final
  finalRating   PerformanceRating?
  finalComments String?            @db.Text

  // Durum
  status ReviewStatus @default(NOT_STARTED)

  // Onaylar
  employeeAcknowledged   Boolean   @default(false)
  employeeAcknowledgedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, employeeId])
  @@index([cycleId])
  @@index([employeeEmail])
  @@index([managerId])
  @@index([status])
  @@index([overallRating])
}

// Performans Hedefi (OKR/KPI)
model PerformanceGoal {
  id       String            @id @default(cuid())
  reviewId String
  review   PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  title       String
  description String?      @db.Text
  category    GoalCategory // BUSINESS, DEVELOPMENT, TEAM

  // Ölçütler
  measureType MeasureType // QUANTITATIVE, QUALITATIVE
  targetValue String? // "100 adet", "90%"
  actualValue String? // Gerçekleşen
  unit        String? // "adet", "%", "TL"

  // Ağırlık
  weight Float @default(1) // Toplam 100 olacak şekilde

  // Değerlendirme
  selfRating    Int? // 1-5
  managerRating Int? // 1-5
  finalRating   Int? // 1-5

  selfComments    String? @db.Text
  managerComments String? @db.Text

  // Durum
  status   GoalProgressStatus @default(ON_TRACK)
  progress Float              @default(0) // 0-100

  // Tarihler
  dueDate     DateTime? @db.Date
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewId])
  @@index([status])
}

// 360 Derece Geri Bildirim
model FeedbackRequest {
  id String @id @default(cuid())

  // Geri bildirim istenen kişi
  subjectId    String
  subjectEmail String
  subjectName  String

  // Geri bildirim veren kişi
  providerId    String
  providerEmail String
  providerName  String
  providerType  FeedbackProviderType // MANAGER, PEER, DIRECT_REPORT, SELF

  // Dönem
  cycleId   String?
  cycleName String?

  // Sorular ve cevaplar
  responses FeedbackResponse[]

  // Genel yorum
  overallComments    String? @db.Text
  strengthsComment   String? @db.Text
  improvementComment String? @db.Text

  // Durum
  status      FeedbackStatus @default(PENDING)
  isAnonymous Boolean        @default(true)

  requestedAt DateTime  @default(now())
  completedAt DateTime?
  dueDate     DateTime? @db.Date

  // İstekte bulunan
  requestedBy     String
  requestedByName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectEmail])
  @@index([providerEmail])
  @@index([status])
}

// Geri Bildirim Cevabı
model FeedbackResponse {
  id                String          @id @default(cuid())
  feedbackRequestId String
  feedbackRequest   FeedbackRequest @relation(fields: [feedbackRequestId], references: [id], onDelete: Cascade)

  questionCode String // Yetkinlik kodu veya soru kodu
  questionText String

  rating  Int? // 1-5
  comment String? @db.Text

  createdAt DateTime @default(now())

  @@index([feedbackRequestId])
}

// ==========================================
// İŞE ALIM (Recruitment)
// ==========================================

// Eleman Talebi Durumu
enum PersonnelRequestStatus {
  DRAFT // Taslak
  PENDING // Onay Bekliyor
  APPROVED // Onaylandı
  REJECTED // Reddedildi
  IN_PROGRESS // İşlemde (İlan açıldı)
  COMPLETED // Tamamlandı
  CANCELLED // İptal edildi
}

// Eleman Talebi Tipi
enum PersonnelRequestType {
  NEW_POSITION // Yeni pozisyon
  REPLACEMENT // Ayrılan personel yerine
  EXPANSION // Kadro genişletme
  TEMPORARY // Geçici/Dönemsel
  INTERN // Stajyer
}

// Eleman Talebi (Personnel Request)
model PersonnelRequest {
  id String @id @default(cuid())

  // Talep numarası
  requestNumber String @unique // PR-2026-001

  // Talep eden
  requesterId    String
  requesterEmail String
  requesterName  String
  department     String

  // Talep detayları
  title          String // "Yazılım Mühendisi"
  requestType    PersonnelRequestType @default(NEW_POSITION)
  headcount      Int                  @default(1) // Kaç kişi isteniyor
  employmentType EmploymentType       @default(FULL_TIME)

  // Açıklama
  justification    String  @db.Text // Neden ihtiyaç var?
  responsibilities String? @db.Text // Görev tanımı
  requirements     String? @db.Text // Aranan özellikler

  // Tercihler
  preferredStartDate DateTime? @db.Date
  location           String?
  workModel          String? // Remote, Hybrid, Onsite

  // Bütçe
  salaryMin Float?
  salaryMax Float?
  hasBudget Boolean @default(false) // Bütçe onayı var mı?

  // Durum
  status   PersonnelRequestStatus @default(DRAFT)
  priority JobPriority            @default(MEDIUM)

  // Onay bilgileri
  approvedById    String?
  approvedByEmail String?
  approvedByName  String?
  approvedAt      DateTime?
  approvalNotes   String?   @db.Text

  // Red bilgileri
  rejectedById    String?
  rejectedByEmail String?
  rejectedByName  String?
  rejectedAt      DateTime?
  rejectionReason String?   @db.Text

  // İlişkili ilan (onaylandığında)
  jobOpeningId String?
  jobOpening   JobOpening? @relation(fields: [jobOpeningId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([department])
  @@index([status])
}

// Açık Pozisyon (İş İlanı)
model JobOpening {
  id String @id @default(cuid())

  // Temel bilgiler
  title          String // "Kıdemli Yazılım Mühendisi"
  code           String         @unique // JOB-2026-001
  department     String
  location       String? // "İstanbul - Merkez"
  employmentType EmploymentType // FULL_TIME, PART_TIME, CONTRACT

  // Bağlı pozisyon
  positionId String? // Position modeline bağlı

  // İlan detayları
  description      String  @db.Text
  responsibilities String? @db.Text
  requirements     String? @db.Text
  qualifications   String? @db.Text
  benefits         String? @db.Text

  // Maaş aralığı
  salaryMin      Float?
  salaryMax      Float?
  salaryCurrency String? @default("TRY")
  showSalary     Boolean @default(false)

  // Raporlama
  hiringManagerId    String?
  hiringManagerEmail String?
  hiringManagerName  String?

  // İK sorumlusu
  recruiterId    String?
  recruiterEmail String?
  recruiterName  String?

  // Sayı
  headcount   Int @default(1) // Kaç kişi alınacak
  filledCount Int @default(0) // Kaç kişi alındı

  // Tarihler
  postingDate    DateTime? @db.Date
  closingDate    DateTime? @db.Date
  targetHireDate DateTime? @db.Date

  // Durum
  status   JobOpeningStatus @default(DRAFT)
  priority JobPriority      @default(MEDIUM)

  // Başvurular
  applications JobApplication[]

  // Mülakat aşamaları
  interviewStages InterviewStage[]

  // Eleman talebi ilişkisi
  personnelRequests PersonnelRequest[]

  createdBy     String
  createdByName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([status])
  @@index([priority])
}

// Aday
model Candidate {
  id String @id @default(cuid())

  // Kişisel bilgiler
  firstName String
  lastName  String
  email     String  @unique
  phone     String?

  // Profesyonel bilgiler
  currentTitle      String?
  currentCompany    String?
  yearsOfExperience Float?
  education         String?  @db.Text
  skills            String[]

  // CV ve belgeler
  resumeUrl    String?
  linkedinUrl  String?
  portfolioUrl String?

  // Kaynak
  source     CandidateSource // DIRECT, REFERRAL, LINKEDIN, JOB_BOARD, AGENCY
  referredBy String? // Referans veren kişi

  // Notlar
  notes String?  @db.Text
  tags  String[]

  // Başvurular
  applications JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([source])
}

// İş Başvurusu
model JobApplication {
  id String @id @default(cuid())

  jobOpeningId String
  jobOpening   JobOpening @relation(fields: [jobOpeningId], references: [id])

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  // Başvuru durumu
  status       ApplicationStatus @default(NEW)
  currentStage String? // Mevcut mülakat aşaması

  // Değerlendirme
  overallRating Int? // 1-5
  fitScore      Int? // Uygunluk skoru (0-100)

  // Mülakat notları
  interviews Interview[]

  // Karar
  decision       HiringDecision?
  decisionNotes  String?         @db.Text
  decisionBy     String?
  decisionByName String?
  decisionAt     DateTime?

  // Teklif
  offerExtended Boolean   @default(false)
  offerAccepted Boolean?
  offerAmount   Float?
  offerDate     DateTime? @db.Date
  startDate     DateTime? @db.Date

  // Reddetme
  rejectionReason String?   @db.Text
  rejectedAt      DateTime?

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobOpeningId, candidateId])
  @@index([jobOpeningId])
  @@index([candidateId])
  @@index([status])
}

// Mülakat Aşaması (Template)
model InterviewStage {
  id           String     @id @default(cuid())
  jobOpeningId String
  jobOpening   JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)

  name        String // "Telefon Görüşmesi", "Teknik Mülakat"
  description String?
  order       Int // Sıralama

  interviewType   InterviewType // PHONE, VIDEO, ONSITE, PANEL
  durationMinutes Int           @default(60)

  // Değerlendiriciler
  evaluatorEmails String[]

  // Sorular/Kriterler
  evaluationCriteria String[] // ["Teknik Bilgi", "Problem Çözme"]

  isRequired Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([jobOpeningId])
  @@index([order])
}

// Gerçekleşen Mülakat
model Interview {
  id            String         @id @default(cuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  stageName  String // Aşama adı
  stageOrder Int? // Aşama sırası

  // Mülakat detayları
  interviewType InterviewType
  scheduledAt   DateTime
  duration      Int? // Dakika
  location      String? // Oda/Link

  // Mülakatçılar
  interviewerIds    String[]
  interviewerEmails String[]
  interviewerNames  String[]

  // Değerlendirme
  overallRating  Int? // 1-5
  recommendation InterviewRecommendation? // STRONG_YES, YES, MAYBE, NO, STRONG_NO

  // Notlar
  notes          String? @db.Text
  strengthsNoted String? @db.Text
  concernsNoted  String? @db.Text

  // Durum
  status InterviewStatus @default(SCHEDULED)

  completedAt         DateTime?
  feedbackSubmittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([scheduledAt])
  @@index([status])
}

// ==========================================
// ORGANİZASYON ŞEMASI (Organization Chart)
// ==========================================

// Organizasyon Birimi
model OrgUnit {
  id String @id @default(cuid())

  code        String  @unique // IT, HR, FIN
  name        String // "Bilgi Teknolojileri"
  shortName   String? // "BT"
  description String? @db.Text

  // Hiyerarşi
  parentId String?
  parent   OrgUnit?  @relation("OrgHierarchy", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgHierarchy")

  // Seviye ve sıra
  level     Int @default(0) // 0=Şirket, 1=Direktörlük, 2=Müdürlük...
  sortOrder Int @default(0)

  // Tip
  unitType OrgUnitType // COMPANY, DIVISION, DEPARTMENT, TEAM, GROUP

  // Yönetici
  managerId    String?
  managerEmail String?
  managerName  String?
  managerPhoto String? // Yönetici fotoğrafı URL

  // Lokasyon
  location String?

  // Bütçe kodu
  costCenter String?

  // Çalışan sayısı (hesaplanan)
  headcount         Int  @default(0)
  approvedHeadcount Int? // Onaylı kadro

  isActive Boolean @default(true)

  // İlişkiler
  employees OrgEmployee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([unitType])
  @@index([level])
  @@index([isActive])
}

// Organizasyon Çalışan Kaydı
model OrgEmployee {
  id String @id @default(cuid())

  // Çalışan bilgileri (AD/User'dan) - boş pozisyonlar için null olabilir
  userId      String? @unique
  email       String?
  displayName String // Dolu pozisyon için isim, boş için pozisyon adı
  title       String?

  // Organizasyon
  orgUnitId String
  orgUnit   OrgUnit @relation(fields: [orgUnitId], references: [id])

  // Raporlama
  reportsToId   String? // Yönetici OrgEmployee ID
  reportsTo     OrgEmployee?  @relation("ReportingLine", fields: [reportsToId], references: [id])
  directReports OrgEmployee[] @relation("ReportingLine")

  // Pozisyon
  positionTitle String?
  positionLevel PositionLevel?

  // İşe giriş
  hireDate DateTime? @db.Date

  // Durum
  employmentStatus EmploymentStatus @default(ACTIVE)

  // Lokasyon
  workLocation String?

  // İletişim
  phone          String?
  officeLocation String?

  // Fotoğraf
  photoUrl String?

  // Son senkronizasyon (AD'den)
  lastSyncedAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgUnitId])
  @@index([reportsToId])
  @@index([employmentStatus])
  @@index([isActive])
}

// Login aktiviteleri loglama
model LoginLog {
  id String @id @default(cuid())

  // Kullanıcı bilgileri
  email      String
  username   String?
  name       String?
  department String?
  role       String?

  // Login durumu
  status       LoginStatus @default(SUCCESS)
  errorMessage String?

  // Teknik bilgiler
  ipAddress String?
  userAgent String?

  // Zaman
  createdAt DateTime @default(now())

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

enum LoginStatus {
  SUCCESS

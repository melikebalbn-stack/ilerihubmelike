// ==========================================
// ISO 27001 Bilgi Güvenliği Yönetim Sistemi
// ==========================================

// ISO 27001 Doküman Kategorileri
enum Iso27001DocumentCategory {
  MANDATORY // Zorunlu Dokümanlar (Madde 4-10)
  RECORD // Zorunlu Kayıtlar
  ANNEX_A // Annex A Kontrol Dokümanları
  POLICY // Politikalar
  PROCEDURE // Prosedürler
  GUIDELINE // Kılavuzlar
  FORM // Formlar
  OTHER // Diğer
}

// ISO 27001 Dokümanlar
model Iso27001Document {
  id             String  @id @default(cuid())
  documentNumber String  @unique // ISO-DOC-2025-0001
  title          String
  description    String? @db.Text

  // Kategori ve Sınıflandırma
  category  Iso27001DocumentCategory
  clause    String? // İlgili madde (örn: "6.1.2", "A.5.1")
  controlId String? // Annex A kontrol ID (örn: "A.5.1")

  // Dosya Bilgileri
  fileName String
  fileUrl  String
  fileType String // pdf, docx, xlsx
  fileSize Int?

  // Versiyon Kontrolü
  version           String  @default("1.0")
  isLatestVersion   Boolean @default(true)
  previousVersionId String?

  // Durum
  status Iso27001DocumentStatus @default(DRAFT)

  // Sahiplik
  ownerId      String
  ownerName    String
  ownerEmail   String
  departmentId String?

  // Onay Bilgileri
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?

  // Gözden Geçirme
  nextReviewDate  DateTime?
  lastReviewDate  DateTime?
  reviewFrequency Int?      @default(365) // Gün cinsinden

  // Hash (bütünlük kontrolü için)
  contentHash String?

  // Metadata
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // İlişkiler
  signatures   Iso27001Signature[]
  versions     Iso27001DocumentVersion[]
  controlLinks Iso27001ControlDocument[]

  @@index([category])
  @@index([status])
  @@index([clause])
  @@index([controlId])
  @@index([nextReviewDate])
}

enum Iso27001DocumentStatus {
  DRAFT // Taslak
  PENDING_APPROVAL // Onay Bekliyor
  APPROVED // Onaylandı
  PUBLISHED // Yayınlandı
  UNDER_REVIEW // Gözden Geçiriliyor
  OBSOLETE // Geçersiz
  ARCHIVED // Arşivlenmiş
}

// Doküman Versiyon Geçmişi
model Iso27001DocumentVersion {
  id         String           @id @default(cuid())
  documentId String
  document   Iso27001Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  version     String
  fileName    String
  fileUrl     String
  fileSize    Int?
  contentHash String?

  changeDescription String? @db.Text
  changedById       String
  changedByName     String

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([version])
}

// Dijital İmza
model Iso27001Signature {
  id         String           @id @default(cuid())
  documentId String
  document   Iso27001Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // İmzalayan Bilgileri
  signerId         String
  signerName       String
  signerEmail      String
  signerTitle      String? // Ünvan
  signerDepartment String?

  // İmza Bilgileri
  signatureCode String   @unique // ILH-SIG-2025-XXXX-YYYY benzersiz kod
  signedAt      DateTime @default(now())

  // Bütünlük Kontrolü
  documentHash String // İmzalanan anki doküman hash'i
  ipAddress    String?
  userAgent    String?

  // İmza Tipi
  signatureType Iso27001SignatureType @default(APPROVAL)

  // Notlar
  notes String? @db.Text

  // Doğrulama
  isVerified Boolean   @default(true)
  verifiedAt DateTime?

  @@index([documentId])
  @@index([signerId])
  @@index([signatureCode])
  @@index([signedAt])
}

enum Iso27001SignatureType {
  APPROVAL // Onay
  REVIEW // Gözden Geçirme
  ACKNOWLEDGMENT // Bilgilenme/Okuma Onayı
  WITNESS // Tanık
}

// ISO 27001 Kontroller (93 Kontrol)
model Iso27001Control {
  id        String @id @default(cuid())
  controlId String @unique // A.5.1, A.5.2, ... A.8.34

  // Kontrol Bilgileri
  title         String
  titleTr       String // Türkçe başlık
  description   String  @db.Text
  descriptionTr String? @db.Text // Türkçe açıklama

  // Kategori
  category       Iso27001ControlCategory
  categoryNumber Int // 5, 6, 7, 8
  controlNumber  Int // 1, 2, 3, ...

  // Uygulama Durumu
  status        Iso27001ControlStatus @default(NOT_APPLICABLE)
  applicability Boolean               @default(true) // SoA'da uygulanabilir mi?
  justification String?               @db.Text // Uygulanmama/uygulama gerekçesi

  // Uygulama Detayları
  implementationNotes String?   @db.Text
  implementationDate  DateTime?
  controlSource       String?   // Kontrol Kaynağı (BGYS, Yasal, Müşteri, vb.)
  relatedAssets       String?   @db.Text // İlgili Varlıklar

  // Sorumlu
  responsibleId    String?
  responsibleName  String?
  responsibleEmail String?

  // Gözden Geçirme
  lastReviewDate DateTime?
  nextReviewDate DateTime?

  // Etkinlik Değerlendirmesi
  effectiveness      Iso27001Effectiveness?
  effectivenessNotes String?                @db.Text
  effectivenessDate  DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // İlişkiler
  documents     Iso27001ControlDocument[]
  evidences     Iso27001Evidence[]
  auditFindings Iso27001AuditFinding[]

  @@index([category])
  @@index([status])
  @@index([applicability])
}

enum Iso27001ControlCategory {
  ORGANIZATIONAL // Organizasyonel (A.5)
  PEOPLE // İnsan (A.6)
  PHYSICAL // Fiziksel (A.7)
  TECHNOLOGICAL // Teknolojik (A.8)
}

enum Iso27001ControlStatus {
  NOT_APPLICABLE // Uygulanmıyor
  NOT_IMPLEMENTED // Uygulanmadı
  PARTIALLY // Kısmen Uygulandı
  IMPLEMENTED // Uygulandı
  EFFECTIVE // Etkin
}

enum Iso27001Effectiveness {
  NOT_MEASURED // Ölçülmedi
  INEFFECTIVE // Etkisiz
  PARTIALLY_EFFECTIVE // Kısmen Etkili
  EFFECTIVE // Etkili
  HIGHLY_EFFECTIVE // Çok Etkili
}

// Kontrol-Doküman İlişkisi
model Iso27001ControlDocument {
  id         String           @id @default(cuid())
  controlId  String
  control    Iso27001Control  @relation(fields: [controlId], references: [id], onDelete: Cascade)
  documentId String
  document   Iso27001Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  relationshipType String? // Politika, Prosedür, Kanıt, vb.

  createdAt DateTime @default(now())

  @@unique([controlId, documentId])
  @@index([controlId])
  @@index([documentId])
}

// Kontrol Kanıtları
model Iso27001Evidence {
  id        String          @id @default(cuid())
  controlId String
  control   Iso27001Control @relation(fields: [controlId], references: [id], onDelete: Cascade)

  title        String
  description  String?              @db.Text
  evidenceType Iso27001EvidenceType

  // Dosya Bilgileri (opsiyonel)
  fileName String?
  fileUrl  String?
  fileType String?

  // Veya referans
  referenceUrl  String?
  referenceNote String? @db.Text

  // Tarih
  evidenceDate DateTime  @default(now())
  validUntil   DateTime?

  // Yükleyen
  uploadedById   String
  uploadedByName String

  createdAt DateTime @default(now())

  @@index([controlId])
  @@index([evidenceType])
}

enum Iso27001EvidenceType {
  DOCUMENT // Doküman
  SCREENSHOT // Ekran Görüntüsü
  LOG // Log Kaydı
  REPORT // Rapor
  CERTIFICATE // Sertifika
  RECORD // Kayıt
  OTHER // Diğer
}

// İç Denetim
model Iso27001Audit {
  id          String @id @default(cuid())
  auditNumber String @unique // ISO-AUD-2025-0001

  title       String
  description String?           @db.Text
  auditType   Iso27001AuditType

  // Denetim Kapsamı
  scope    String?  @db.Text
  clauses  String[] // Denetlenecek maddeler
  controls String[] // Denetlenecek kontroller (A.5.1, A.5.2, vb.)

  // Tarihler
  plannedDate DateTime
  startDate   DateTime?
  endDate     DateTime?

  // Denetim Ekibi
  leadAuditorId    String
  leadAuditorName  String
  leadAuditorEmail String

  // Denetlenen
  auditeeId         String?
  auditeeName       String?
  auditeeEmail      String?
  auditeeDepartment String?

  // Durum
  status Iso27001AuditStatus @default(PLANNED)

  // Sonuçlar
  summary    String? @db.Text
  conclusion String? @db.Text

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // İlişkiler
  teamMembers Iso27001AuditTeamMember[]
  findings    Iso27001AuditFinding[]

  @@index([status])
  @@index([plannedDate])
  @@index([auditType])
}

enum Iso27001AuditType {
  INTERNAL // İç Denetim
  EXTERNAL // Dış Denetim
  SURVEILLANCE // Gözetim Denetimi
  CERTIFICATION // Belgelendirme Denetimi
  SUPPLIER // Tedarikçi Denetimi
}

enum Iso27001AuditStatus {
  PLANNED // Planlandı
  IN_PROGRESS // Devam Ediyor
  COMPLETED // Tamamlandı
  CANCELLED // İptal Edildi
}

// Denetim Ekibi Üyeleri
model Iso27001AuditTeamMember {
  id      String        @id @default(cuid())
  auditId String
  audit   Iso27001Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  memberId    String
  memberName  String
  memberEmail String
  role        String? // Lider Denetçi, Denetçi, Teknik Uzman

  createdAt DateTime @default(now())

  @@index([auditId])
}

// Denetim Bulguları
model Iso27001AuditFinding {
  id      String        @id @default(cuid())
  auditId String
  audit   Iso27001Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  findingNumber String // AUD-2025-001-F01

  // İlgili Kontrol/Madde
  controlId String?
  control   Iso27001Control? @relation(fields: [controlId], references: [id])
  clause    String?

  // Bulgu Detayları
  findingType Iso27001FindingType
  title       String
  description String              @db.Text
  evidence    String?             @db.Text

  // Risk Değerlendirmesi
  severity Iso27001FindingSeverity @default(MINOR)

  // Düzeltici Faaliyet
  correctiveAction String?   @db.Text
  responsibleId    String?
  responsibleName  String?
  dueDate          DateTime?
  completedDate    DateTime?

  // Doğrulama
  verifiedById      String?
  verifiedByName    String?
  verifiedAt        DateTime?
  verificationNotes String?   @db.Text

  // Durum
  status Iso27001FindingStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auditId])
  @@index([controlId])
  @@index([status])
  @@index([findingType])
}

enum Iso27001FindingType {
  MAJOR_NC // Majör Uygunsuzluk
  MINOR_NC // Minör Uygunsuzluk
  OBSERVATION // Gözlem
  OPPORTUNITY // İyileştirme Fırsatı
  POSITIVE // Olumlu Bulgu
}

enum Iso27001FindingSeverity {
  CRITICAL // Kritik
  MAJOR // Majör
  MINOR // Minör
  LOW // Düşük
}

enum Iso27001FindingStatus {
  OPEN // Açık
  IN_PROGRESS // İşlemde
  PENDING_VERIFICATION // Doğrulama Bekliyor
  CLOSED // Kapatıldı
}

// Risk Değerlendirmesi
model Iso27001Risk {
  id         String @id @default(cuid())
  riskNumber String @unique // ISO-RSK-2025-0001

  // Varlık Bilgisi
  assetName  String
  assetType  String?
  assetOwner String?

  // Tehdit ve Açıklık
  threat        String
  vulnerability String

  // Risk Tanımı
  title       String
  description String @db.Text

  // Risk Değerlendirmesi
  likelihood Int // 1-5
  impact     Int // 1-5
  riskScore  Int // likelihood * impact
  riskLevel  Iso27001RiskLevel

  // Risk İşleme
  treatmentOption Iso27001RiskTreatment?
  treatmentPlan   String?                @db.Text
  residualRisk    Int? // İşleme sonrası risk skoru

  // İlgili Kontroller
  relatedControls String[] // A.5.1, A.8.1, vb.

  // Sorumlu
  ownerId    String
  ownerName  String
  ownerEmail String

  // Tarihler
  identifiedDate DateTime  @default(now())
  reviewDate     DateTime?
  nextReviewDate DateTime?

  // Durum
  status Iso27001RiskStatus @default(IDENTIFIED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([riskLevel])
  @@index([status])
  @@index([nextReviewDate])
}

enum Iso27001RiskLevel {
  VERY_LOW // Çok Düşük (1-4)
  LOW // Düşük (5-8)
  MEDIUM // Orta (9-12)
  HIGH // Yüksek (13-19)
  VERY_HIGH // Çok Yüksek (20-25)
}

enum Iso27001RiskTreatment {
  AVOID // Kaçınma
  MITIGATE // Azaltma
  TRANSFER // Transfer
  ACCEPT // Kabul
}

enum Iso27001RiskStatus {
  IDENTIFIED // Tanımlandı
  ASSESSING // Değerlendiriliyor
  TREATING // İşleniyor
  MONITORING // İzleniyor
  CLOSED // Kapatıldı
}

// Yönetim Gözden Geçirme
model Iso27001ManagementReview {
  id           String @id @default(cuid())
  reviewNumber String @unique // ISO-MGT-2025-Q1

  title      String
  reviewDate DateTime

  // Katılımcılar
  participants String @db.Text // JSON array
  chairperson  String

  // Gözden Geçirme Girdileri
  auditResults     String? @db.Text
  feedbacks        String? @db.Text
  incidentSummary  String? @db.Text
  riskStatus       String? @db.Text
  objectivesStatus String? @db.Text
  previousActions  String? @db.Text
  changes          String? @db.Text
  improvements     String? @db.Text

  // Gözden Geçirme Çıktıları
  decisions     String? @db.Text
  actionItems   String? @db.Text // JSON array
  resourceNeeds String? @db.Text

  // Durum
  status Iso27001ReviewStatus @default(DRAFT)

  // Onay
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?

  // Doküman
  minutesUrl String? // Toplantı tutanağı

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewDate])
  @@index([status])
}

enum Iso27001ReviewStatus {
  DRAFT // Taslak
  COMPLETED // Tamamlandı
  APPROVED // Onaylandı
}

// BGYS Eğitim Kayıtları
model Iso27001Training {
  id             String   @id @default(cuid())
  trainingNumber String   @unique // TRN-2025-001

  // Eğitim Bilgileri
  title          String // Eğitim Konusu
  description    String?  @db.Text
  trainingType   Iso27001TrainingType @default(AWARENESS)
  duration       Int      @default(60) // Dakika cinsinden
  location       String?  // Eğitim yeri (online ise boş)

  // Eğitim Modu
  isOnline       Boolean  @default(false) // Online/dijital eğitim mi?
  contentType    String?  // PDF, VIDEO, PRESENTATION
  contentUrl     String?  // Eğitim içeriği URL'si

  // Zorunlu görüntüleme
  minViewTime    Int?     // Minimum görüntüleme süresi (saniye)
  hasQuiz        Boolean  @default(false)
  passingScore   Int?     // Quiz geçme notu (%)

  // Eğitimci
  trainerName    String
  trainerTitle   String?
  trainerEmail   String?

  // Tarihler
  trainingDate   DateTime
  plannedDate    DateTime?
  deadline       DateTime? // Tamamlama son tarihi

  // İlişkili Kontrol
  controlId      String?  // A.6.3 gibi

  // Katılımcılar (yüz yüze eğitimler için)
  participants   Iso27001TrainingParticipant[]

  // Atamalar (online eğitimler için)
  assignments    Iso27001TrainingAssignment[]

  // Dosyalar
  documentUrl    String?  // Eğitim materyali
  signatureUrl   String?  // İmzalı katılım formu

  // Durum
  status         Iso27001TrainingStatus @default(PLANNED)

  // Meta
  createdById    String?
  createdByName  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([trainingDate])
  @@index([status])
  @@index([controlId])
  @@index([isOnline])
}

// Eğitim Katılımcıları (yüz yüze eğitimler için)
model Iso27001TrainingParticipant {
  id           String @id @default(cuid())

  trainingId   String
  training     Iso27001Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  // Katılımcı Bilgileri
  name         String
  title        String?  // Görev/Ünvan
  department   String?
  email        String?

  // Katılım
  attended     Boolean  @default(true)
  signedAt     DateTime?

  createdAt    DateTime @default(now())

  @@index([trainingId])
}

// Online Eğitim Atamaları
model Iso27001TrainingAssignment {
  id           String @id @default(cuid())

  trainingId   String
  training     Iso27001Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  // Atanan kullanıcı
  userId       String
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Atama bilgileri
  assignedAt   DateTime @default(now())
  assignedById String?
  assignedByName String?
  deadline     DateTime? // Kişiye özel deadline

  // İlerleme
  status       Iso27001AssignmentStatus @default(PENDING)
  startedAt    DateTime? // Eğitime başlama zamanı
  viewTime     Int       @default(0) // Toplam görüntüleme süresi (saniye)
  progress     Int       @default(0) // İlerleme yüzdesi (0-100)

  // Quiz sonuçları
  quizScore    Int?      // Quiz puanı
  quizAttempts Int       @default(0) // Quiz deneme sayısı
  quizPassedAt DateTime? // Quiz geçme tarihi

  // Tamamlama ve İmza
  completedAt  DateTime? // Tamamlama tarihi

  // Dijital İmza
  signedAt     DateTime?
  signatureHash String?  // İmza hash'i (şifre + zaman + kullanıcı)
  signatureIp  String?   // İmza atılan IP
  signatureDevice String? // Cihaz bilgisi

  // Hatırlatmalar
  reminderSent Boolean   @default(false)
  reminderCount Int      @default(0)
  lastReminderAt DateTime?

  // Sertifika
  certificateUrl String? // Oluşturulan sertifika

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([trainingId, userId])
  @@index([trainingId])
  @@index([userId])
  @@index([status])
  @@index([deadline])
}

enum Iso27001TrainingType {
  AWARENESS    // Farkındalık Eğitimi
  TECHNICAL    // Teknik Eğitim
  ORIENTATION  // Oryantasyon
  REFRESHER    // Yenileme Eğitimi
  SPECIALIZED  // Özel Eğitim
}

enum Iso27001TrainingStatus {
  PLANNED      // Planlandı
  IN_PROGRESS  // Devam Ediyor
  COMPLETED    // Tamamlandı
  CANCELLED    // İptal Edildi
}

enum Iso27001AssignmentStatus {
  PENDING      // Bekliyor
  IN_PROGRESS  // Devam Ediyor
  COMPLETED    // Tamamlandı (imza bekleniyor)
  SIGNED       // İmzalandı
  EXPIRED      // Süresi Doldu
}

// ===== ISO 27001 Varlık Envanteri (A.5.9) =====

model Iso27001Asset {
  id          String @id @default(cuid())
  assetNumber String @unique // ASSET-001 formatında

  // Varlık Bilgileri
  name        String
  description String? @db.Text
  category    Iso27001AssetCategory
  type        Iso27001AssetType

  // Konum ve Sahiplik
  location    String?
  department  String?
  ownerId     String?
  owner       User?   @relation("AssetOwner", fields: [ownerId], references: [id])
  custodianId String?
  custodian   User?   @relation("AssetCustodian", fields: [custodianId], references: [id])

  // Değerleme
  confidentiality    Int       @default(1) // 1-5
  integrity          Int       @default(1) // 1-5
  availability       Int       @default(1) // 1-5
  assetValue         Int?      // Hesaplanan değer (C+I+A)
  financialValue     Float?    // Maddi değer (TL)
  criticality        Iso27001AssetCriticality @default(LOW)

  // Sınıflandırma
  classification     Iso27001Classification @default(INTERNAL)

  // Durum
  status             Iso27001AssetStatus @default(ACTIVE)
  acquisitionDate    DateTime?
  disposalDate       DateTime?

  // Teknik Bilgiler (yazılım/donanım için)
  manufacturer       String?
  model              String?
  serialNumber       String?
  version            String?
  licenseType        String?
  licenseExpiry      DateTime?

  // İlişkiler
  parentAssetId      String?
  parentAsset        Iso27001Asset?  @relation("AssetHierarchy", fields: [parentAssetId], references: [id])
  childAssets        Iso27001Asset[] @relation("AssetHierarchy")

  // Notlar
  notes              String? @db.Text

  // Zaman Damgaları
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lastReviewDate     DateTime?
  nextReviewDate     DateTime?

  @@index([category])
  @@index([type])
  @@index([ownerId])
  @@index([status])
  @@index([classification])
}

enum Iso27001AssetCategory {
  INFORMATION        // Bilgi Varlıkları
  SOFTWARE           // Yazılım Varlıkları
  HARDWARE           // Donanım Varlıkları
  NETWORK            // Ağ Varlıkları
  PERSONNEL          // İnsan Kaynakları
  PHYSICAL           // Fiziksel Varlıklar
  SERVICE            // Hizmetler
  INTANGIBLE         // Soyut Varlıklar (marka, itibar vb.)
}

enum Iso27001AssetType {
  // Bilgi
  DATABASE           // Veritabanı
  DOCUMENT           // Doküman
  RECORD             // Kayıt
  BACKUP             // Yedek
  // Yazılım
  APPLICATION        // Uygulama
  OPERATING_SYSTEM   // İşletim Sistemi
  MIDDLEWARE         // Ara Katman
  DEVELOPMENT_TOOL   // Geliştirme Aracı
  // Donanım
  SERVER             // Sunucu
  DESKTOP            // Masaüstü Bilgisayar
  LAPTOP             // Dizüstü Bilgisayar
  MOBILE_DEVICE      // Mobil Cihaz
  STORAGE            // Depolama
  PRINTER            // Yazıcı
  // Ağ
  ROUTER             // Yönlendirici
  SWITCH             // Anahtar
  FIREWALL           // Güvenlik Duvarı
  ACCESS_POINT       // Erişim Noktası
  // Fiziksel
  BUILDING           // Bina
  ROOM               // Oda
  CABINET            // Kabin
  MEDIA              // Ortam (USB, CD vb.)
  // Hizmet
  CLOUD_SERVICE      // Bulut Hizmeti
  EXTERNAL_SERVICE   // Dış Hizmet
  UTILITY            // Altyapı Hizmeti
  // Diğer
  OTHER              // Diğer
}

enum Iso27001AssetCriticality {
  CRITICAL           // Kritik
  HIGH               // Yüksek
  MEDIUM             // Orta
  LOW                // Düşük
}

enum Iso27001Classification {
  PUBLIC             // Genel
  INTERNAL           // Dahili
  CONFIDENTIAL       // Gizli
  RESTRICTED         // Kısıtlı
}

enum Iso27001AssetStatus {
  ACTIVE             // Aktif
  INACTIVE           // Pasif
  UNDER_MAINTENANCE  // Bakımda
  DISPOSED           // İmha Edildi
  LOST               // Kayıp
}

// ===== ISO 27001 Bilgi Güvenliği Olay Yönetimi =====

model Iso27001Incident {
  id              String @id @default(cuid())
  incidentNumber  String @unique // INC-2026-001 formatında

  // Olay Bilgileri
  title           String
  description     String @db.Text
  category        Iso27001IncidentCategory
  severity        Iso27001IncidentSeverity
  status          Iso27001IncidentStatus @default(REPORTED)

  // Tespit ve Raporlama
  detectedAt      DateTime // Olayın tespit edildiği tarih
  reportedAt      DateTime @default(now()) // Raporlama tarihi
  reportedById    String
  reportedBy      User @relation("IncidentReporter", fields: [reportedById], references: [id])

  // Etkilenen Sistemler/Varlıklar
  affectedSystems String?  @db.Text // Virgülle ayrılmış liste
  affectedAssets  String?  @db.Text
  impactScope     String?  // Etki alanı: Departman, Şirket geneli, vb.

  // Sorumluluk ve Atama
  assignedToId    String?
  assignedTo      User? @relation("IncidentHandler", fields: [assignedToId], references: [id])

  // Müdahale Bilgileri
  immediateActions String? @db.Text // Alınan acil önlemler
  containmentAt   DateTime? // Kontrol altına alınma tarihi

  // Kök Neden Analizi
  rootCause       String?  @db.Text
  rootCauseAnalyzedAt DateTime?

  // Çözüm ve Düzeltici Faaliyetler
  resolution      String?  @db.Text
  resolvedAt      DateTime?
  resolvedById    String?

  // Kapatma
  closedAt        DateTime?
  closedById      String?
  closureNotes    String?  @db.Text
  lessonsLearned  String?  @db.Text // Öğrenilen dersler

  // İlişkili Kontroller
  relatedControls String?  // Virgülle ayrılmış kontrol ID'leri (5.24, 5.25, vb.)

  // Eklentiler
  attachments     Iso27001IncidentAttachment[]
  actions         Iso27001IncidentAction[]
  timeline        Iso27001IncidentTimeline[]

  // Meta
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([incidentNumber])
  @@index([status])
  @@index([severity])
  @@index([reportedById])
  @@index([assignedToId])
  @@index([detectedAt])
}

model Iso27001IncidentAttachment {
  id          String @id @default(cuid())
  incidentId  String
  incident    Iso27001Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String?
  uploadedById String
  uploadedAt  DateTime @default(now())

  @@index([incidentId])
}

model Iso27001IncidentAction {
  id          String @id @default(cuid())
  incidentId  String
  incident    Iso27001Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  // Aksiyon Bilgileri
  title       String
  description String? @db.Text
  actionType  Iso27001IncidentActionType
  priority    Iso27001ActionPriority @default(MEDIUM)

  // Sorumluluk
  assignedToId String?
  assignedTo   User? @relation(fields: [assignedToId], references: [id])

  // Tarihler
  dueDate     DateTime?
  completedAt DateTime?
  status      Iso27001ActionStatus @default(OPEN)

  // Notlar
  notes       String? @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([incidentId])
  @@index([status])
  @@index([assignedToId])
}

model Iso27001IncidentTimeline {
  id          String @id @default(cuid())
  incidentId  String
  incident    Iso27001Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  action      String // Yapılan işlem
  description String? @db.Text
  performedById String?
  performedByName String?
  performedAt DateTime @default(now())

  @@index([incidentId])
  @@index([performedAt])
}

enum Iso27001IncidentCategory {
  MALWARE           // Zararlı Yazılım
  PHISHING          // Oltalama
  UNAUTHORIZED_ACCESS // Yetkisiz Erişim
  DATA_BREACH       // Veri İhlali
  DATA_LOSS         // Veri Kaybı
  DENIAL_OF_SERVICE // Hizmet Reddi
  SOCIAL_ENGINEERING // Sosyal Mühendislik
  PHYSICAL_SECURITY // Fiziksel Güvenlik
  POLICY_VIOLATION  // Politika İhlali
  SYSTEM_FAILURE    // Sistem Arızası
  HUMAN_ERROR       // İnsan Hatası
  OTHER             // Diğer
}

enum Iso27001IncidentSeverity {
  CRITICAL // Kritik - Acil müdahale
  HIGH     // Yüksek - 24 saat içinde
  MEDIUM   // Orta - 72 saat içinde
  LOW      // Düşük - Planlı müdahale
}

enum Iso27001IncidentStatus {
  REPORTED    // Raporlandı
  ANALYZING   // İnceleniyor
  CONTAINED   // Kontrol Altında
  RESOLVING   // Çözülüyor
  RESOLVED    // Çözüldü
  CLOSED      // Kapatıldı
}

enum Iso27001IncidentActionType {
  IMMEDIATE   // Acil Aksiyon
  CORRECTIVE  // Düzeltici Faaliyet
  PREVENTIVE  // Önleyici Faaliyet
  IMPROVEMENT // İyileştirme
}

enum Iso27001ActionPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum Iso27001ActionStatus {
  OPEN        // Açık
  IN_PROGRESS // Devam Ediyor
  COMPLETED   // Tamamlandı
  CANCELLED   // İptal
}

// ==========================================
// FORMLAR MODÜLÜ - ZİYARET RAPORLARI
// ==========================================

model VisitReport {
  id              String @id @default(cuid())
  reportNumber    String @unique // ZR-2025-001 formatında

  // Temel Bilgiler
  visitDate       DateTime
  endDate         DateTime?
  visitTime       String // "10:00" formatında
  companyName     String // Ziyaret edilen firma
  visitType       VisitType
  location        String? // Ziyaret yeri/adres
  project         String? // İlgili proje/konu

  // Görüşme Özeti
  meetingSummary  String @db.Text

  // Ek Notlar
  additionalNotes String? @db.Text
  nextSteps       String? @db.Text

  // Dosya Ekleri
  attachments     VisitReportAttachment[]

  // Katılımcılar
  participants    VisitReportParticipant[]

  // Aksiyon Maddeleri
  actionItems     VisitReportAction[]

  // E-posta Gönderim Geçmişi
  emailLogs       VisitReportEmailLog[]

  // Oluşturan/Onaylayan
  createdById     String
  createdBy       User @relation("VisitReportCreatedBy", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User? @relation("VisitReportApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?

  // Durum
  status          VisitReportStatus @default(DRAFT)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdById])
  @@index([status])
  @@index([visitDate])
  @@index([companyName])
}

model VisitReportParticipant {
  id            String @id @default(cuid())
  reportId      String
  report        VisitReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  name          String
  title         String? // Unvan
  company       ParticipantCompany // ILERI_GROUP veya VISITED_COMPANY

  createdAt     DateTime @default(now())

  @@index([reportId])
}

model VisitReportAction {
  id            String @id @default(cuid())
  reportId      String
  report        VisitReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  description   String
  responsible   String // Sorumlu kişi/departman
  dueDate       DateTime?
  status        ActionItemStatus @default(PENDING)
  completedAt   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([reportId])
  @@index([status])
}

model VisitReportAttachment {
  id            String @id @default(cuid())
  reportId      String
  report        VisitReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  fileName      String
  filePath      String
  fileSize      Int
  mimeType      String

  createdAt     DateTime @default(now())

  @@index([reportId])
}

model VisitReportEmailLog {
  id            String @id @default(cuid())
  reportId      String
  report        VisitReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  sentBy        String   // Gönderen kullanıcı email
  sentByName    String?  // Gönderen kullanıcı adı
  recipients    String   @db.Text // JSON array: [{"name":"...","email":"..."}]

  sentAt        DateTime @default(now())

  @@index([reportId])
}

enum VisitType {
  CUSTOMER      // Müşteri Ziyareti
  SUPPLIER      // Tedarikçi Ziyareti
  FAIR          // Fuar/Etkinlik
  TECHNICAL     // Teknik Görüşme
  AUDIT         // Denetim/Audit
  TRAINING      // Eğitim
  OTHER         // Diğer
}

enum VisitReportStatus {
  DRAFT         // Taslak
  SENT          // Gönderildi
  PENDING       // Onay Bekliyor
  APPROVED      // Onaylandı
  REJECTED      // Reddedildi
}

enum ParticipantCompany {
  ILERI_GROUP     // İleri Grup'tan
  VISITED_COMPANY // Ziyaret edilen firmadan
}

enum ActionItemStatus {
  PENDING     // Bekliyor
  IN_PROGRESS // Devam Ediyor
  COMPLETED   // Tamamlandı
  CANCELLED   // İptal
}

// ==========================================
// TOPLANTI YÖNETİM SİSTEMİ
// ==========================================

model Meeting {
  id              String @id @default(cuid())
  meetingNumber   String @unique // TPL-2026-0001
  
  // Temel Bilgiler
  title           String
  description     String? @db.Text
  meetingType     MeetingType
  
  // Tarih/Saat
  scheduledDate   DateTime
  startTime       DateTime?
  endTime         DateTime?
  duration        Int? // dakika cinsinden
  
  // Konum
  location        String?
  isOnline        Boolean @default(false)
  onlineLink      String?
  
  // Organizatör
  organizerId     String
  organizer       User @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  
  // Toplantı Başkanı ve Raportör
  chairmanId      String?
  chairman        User? @relation("MeetingChairman", fields: [chairmanId], references: [id])
  rapporteurId    String?
  rapporteur      User? @relation("MeetingRapporteur", fields: [rapporteurId], references: [id])
  
  // Departman (opsiyonel)
  department      String?
  
  // Durum
  status          MeetingStatus @default(PLANNED)
  
  // İlişkiler
  attendees       MeetingAttendee[]
  agendaItems     MeetingAgendaItem[]
  decisions       MeetingDecision[]
  attachments     MeetingAttachment[]
  
  // Tutanak
  minutesApproved Boolean @default(false)
  minutesApprovedAt DateTime?
  minutesApprovedById String?
  minutesApprovedBy User? @relation("MeetingMinutesApprover", fields: [minutesApprovedById], references: [id])
  
  // Notlar
  openingRemarks  String? @db.Text
  closingRemarks  String? @db.Text
  generalNotes    String? @db.Text
  
  // Önceki/Sonraki toplantı referansı
  previousMeetingId String?
  previousMeeting Meeting? @relation("MeetingChain", fields: [previousMeetingId], references: [id])
  nextMeetings    Meeting[] @relation("MeetingChain")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizerId])
  @@index([status])
  @@index([scheduledDate])
  @@index([meetingType])
  @@index([department])
}

model MeetingAttendee {
  id              String @id @default(cuid())
  meetingId       String
  meeting         Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  // Dahili katılımcı
  userId          String?
  user            User? @relation("MeetingAttendees", fields: [userId], references: [id])
  
  // Harici katılımcı (misafir)
  externalName    String?
  externalEmail   String?
  externalCompany String?
  externalTitle   String?
  
  // Katılım durumu
  inviteStatus    InviteStatus @default(PENDING)
  attendanceStatus AttendanceStatus @default(UNKNOWN)
  absenceReason   String?
  
  // Rol
  role            AttendeeRole @default(PARTICIPANT)
  
  arrivalTime     DateTime?
  departureTime   DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
}

model MeetingAgendaItem {
  id              String @id @default(cuid())
  meetingId       String
  meeting         Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  orderNo         Int
  title           String
  description     String? @db.Text
  
  // Sunan kişi
  presenterId     String?
  presenter       User? @relation("AgendaPresenter", fields: [presenterId], references: [id])
  presenterName   String? // Harici kişi için
  
  // Süre
  plannedDuration Int? // dakika
  actualDuration  Int? // dakika
  
  // Tartışma ve Sonuç
  discussionNotes String? @db.Text
  outcome         AgendaOutcome?
  outcomeNotes    String?
  
  // Oylama (gerekirse)
  votesFor        Int?
  votesAgainst    Int?
  votesAbstain    Int?
  
  // Durum
  status          AgendaItemStatus @default(PENDING)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([meetingId])
  @@index([orderNo])
}

model MeetingDecision {
  id              String @id @default(cuid())
  meetingId       String
  meeting         Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  decisionNumber  String // K-001, K-002
  
  // Karar detayları
  title           String
  description     String @db.Text
  
  // Sorumlu
  responsibleId   String?
  responsible     User? @relation("DecisionResponsible", fields: [responsibleId], references: [id])
  responsibleName String? // Harici kişi veya departman için
  
  // Tarih ve öncelik
  dueDate         DateTime?
  priority        MeetingPriority @default(MEDIUM)
  
  // Durum takibi
  status          DecisionStatus @default(PENDING)
  completedAt     DateTime?
  completionNotes String?
  
  // İlişkili görev (Planlı Görevler modülü ile entegrasyon)
  linkedTaskId    String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([meetingId])
  @@index([responsibleId])
  @@index([status])
  @@index([dueDate])
}

model MeetingAttachment {
  id              String @id @default(cuid())
  meetingId       String
  meeting         Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  fileName        String
  filePath        String
  fileSize        Int
  mimeType        String
  
  uploadedById    String
  uploadedBy      User @relation("MeetingAttachmentUploader", fields: [uploadedById], references: [id])
  
  createdAt       DateTime @default(now())

  @@index([meetingId])
}

// ========================================
// PROJE PLANI (Adam/Gün Karşılaştırması)
// ========================================

model ProjectPlan {
  id              String @id @default(cuid())
  planNumber      String @unique // PP-2026-0001

  // Temel Bilgiler
  title           String
  description     String? @db.Text

  // Sütun etiketleri (özelleştirilebilir)
  label1          String @default("Danışman")
  label2          String @default("Hedef")
  label3          String @default("Gerçekleşen")

  // Oluşturan
  createdById     String
  createdBy       User @relation("ProjectPlanCreator", fields: [createdById], references: [id])

  // Durum
  status          ProjectPlanStatus @default(ACTIVE)

  // Maddeler
  items           ProjectPlanItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdById])
  @@index([status])
}

model ProjectPlanItem {
  id              String @id @default(cuid())
  planId          String
  plan            ProjectPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  orderNo         Int
  name            String
  consultant      Int @default(0) // Danışman hedefi (adam/gün)
  target          Int @default(0) // Bizim hedef (adam/gün)
  actual          Int @default(0) // Gerçekleşen (adam/gün)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([planId])
  @@index([orderNo])
}

enum ProjectPlanStatus {
  ACTIVE          // Aktif
  COMPLETED       // Tamamlandı
  ARCHIVED        // Arşivlendi
}

// Toplantı Türleri
enum MeetingType {
  BOARD           // Yönetim Kurulu
  MANAGEMENT      // Yönetim Toplantısı
  DEPARTMENT      // Departman Toplantısı
  PROJECT         // Proje Toplantısı
  WEEKLY          // Haftalık Toplantı
  MONTHLY         // Aylık Toplantı
  ONE_ON_ONE      // 1:1 Görüşme
  BRAINSTORM      // Beyin Fırtınası
  TRAINING        // Eğitim
  REVIEW          // Değerlendirme
  EMERGENCY       // Acil Toplantı
  OTHER           // Diğer
}

// Toplantı Durumu
enum MeetingStatus {
  PLANNED         // Planlandı
  IN_PROGRESS     // Devam Ediyor
  COMPLETED       // Tamamlandı
  CANCELLED       // İptal Edildi
  POSTPONED       // Ertelendi
}

// Davet Durumu
enum InviteStatus {
  PENDING         // Bekliyor
  ACCEPTED        // Kabul Edildi
  DECLINED        // Reddedildi
  TENTATIVE       // Belirsiz
}

// Katılım Durumu
enum AttendanceStatus {
  UNKNOWN         // Bilinmiyor
  PRESENT         // Katıldı
  ABSENT          // Katılmadı
  LATE            // Geç Geldi
  LEFT_EARLY      // Erken Ayrıldı
  EXCUSED         // Mazeretli
}

// Katılımcı Rolü
enum AttendeeRole {
  CHAIRMAN        // Toplantı Başkanı
  RAPPORTEUR      // Raportör
  PRESENTER       // Sunucu
  PARTICIPANT     // Katılımcı
  OBSERVER        // Gözlemci
  GUEST           // Misafir
}

// Gündem Maddesi Sonucu
enum AgendaOutcome {
  APPROVED        // Onaylandı
  REJECTED        // Reddedildi
  POSTPONED       // Ertelendi
  NEEDS_INFO      // Bilgi Gerekli
  NOTED           // Not Edildi
  NO_DECISION     // Karar Alınmadı
}

// Gündem Maddesi Durumu
enum AgendaItemStatus {
  PENDING         // Bekliyor
  DISCUSSED       // Tartışıldı
  SKIPPED         // Atlandı
}

// Karar Durumu
enum DecisionStatus {
  PENDING         // Bekliyor
  IN_PROGRESS     // Devam Ediyor
  COMPLETED       // Tamamlandı
  OVERDUE         // Gecikmiş
  CANCELLED       // İptal
}

// Toplantı Karar Önceliği
enum MeetingPriority {
  LOW             // Düşük
  MEDIUM          // Orta
  HIGH            // Yüksek
  URGENT          // Acil
}

// ==========================================
// Maliyet Analizi Modülü (Cost Analysis)
// ==========================================

// Ana Model: Maliyet Analizi
model CostAnalysis {
  id                String   @id @default(cuid())
  code              String   @unique  // 2910, 2911, vb.
  name              String             // 2'li TG
  description       String?  @db.Text
  revision          String   @default("A")

  // Ürün bilgileri
  finishedWeight    Decimal  @db.Decimal(10, 2)  // kg
  currency          CostCurrency @default(EUR)

  // İlişkiler
  categoryId        String?
  category          CostCategory? @relation(fields: [categoryId], references: [id])
  customerId        String?
  customer          CostCustomer? @relation(fields: [customerId], references: [id])

  // Hesaplanan değerler (cache)
  materialCost      Decimal  @default(0) @db.Decimal(12, 2)
  laborCost         Decimal  @default(0) @db.Decimal(12, 2)
  externalCost      Decimal  @default(0) @db.Decimal(12, 2)
  otherCost         Decimal  @default(0) @db.Decimal(12, 2)
  subtotal          Decimal  @default(0) @db.Decimal(12, 2)

  // Genel gider ve kar
  overheadRate      Decimal  @default(25) @db.Decimal(5, 2)  // %
  overheadAmount    Decimal  @default(0) @db.Decimal(12, 2)
  totalCost         Decimal  @default(0) @db.Decimal(12, 2)

  profitRate        Decimal  @default(20) @db.Decimal(5, 2)  // %
  profitAmount      Decimal  @default(0) @db.Decimal(12, 2)
  salesPrice        Decimal  @default(0) @db.Decimal(12, 2)
  pricePerKg        Decimal  @default(0) @db.Decimal(10, 2)

  // Durum
  status            CostAnalysisStatus @default(DRAFT)

  // Onay bilgileri
  approvedById      String?
  approvedAt        DateTime?
  rejectionReason   String?  @db.Text

  // Audit
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Alt tablolar
  materials         CostMaterial[]
  laborItems        CostLabor[]
  externalServices  CostExternalService[]
  otherCosts        CostOtherItem[]
  versions          CostAnalysisVersion[]

  @@index([status])
  @@index([categoryId])
  @@index([customerId])
  @@index([createdAt])
}

enum CostAnalysisStatus {
  DRAFT           // Taslak
  PENDING_REVIEW  // İncelemede
  APPROVED        // Onaylı
  REJECTED        // Reddedildi
  ARCHIVED        // Arşivlenmiş
}

enum CostCurrency {
  TRY
  EUR
  USD
  GBP
}

// Malzeme: CostMaterial
model CostMaterial {
  id              String   @id @default(cuid())
  costAnalysisId  String
  costAnalysis    CostAnalysis @relation(fields: [costAnalysisId], references: [id], onDelete: Cascade)

  // Malzeme bilgileri
  materialCode    String?
  name            String
  specification   String?
  category        MaterialCostCategory @default(RAW_MATERIAL)

  // Miktar ve fiyat
  unit            String   @default("kg")
  currency        CostCurrency @default(EUR)
  grossQuantity   Decimal  @db.Decimal(10, 3)
  wasteRate       Decimal  @default(0) @db.Decimal(5, 2)  // Fire %
  netQuantity     Decimal  @db.Decimal(10, 3)  // Hesaplanan
  unitPrice       Decimal  @db.Decimal(10, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)  // Hesaplanan

  // Tedarikçi
  supplierId      String?
  supplier        CostSupplier? @relation(fields: [supplierId], references: [id])

  // Sıralama
  sortOrder       Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([costAnalysisId])
  @@index([supplierId])
}

enum MaterialCostCategory {
  RAW_MATERIAL      // Hammadde
  SEMI_FINISHED     // Yarı mamul
  PURCHASED_PART    // Satın alınan parça
  STANDARD_PART     // Standart parça (cıvata, somun)
  CONSUMABLE        // Sarf malzeme
}

// Malzeme Kataloğu: Paylaşılan malzeme kütüphanesi
model CostMaterialCatalog {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  specification   String?
  category        MaterialCostCategory @default(RAW_MATERIAL)
  unit            String   @default("kg")
  currency        CostCurrency @default(EUR)
  unitPrice       Decimal  @db.Decimal(10, 2)

  supplierId      String?
  supplier        CostSupplier? @relation(fields: [supplierId], references: [id])

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([supplierId])
}

// İşçilik: CostLabor
model CostLabor {
  id              String   @id @default(cuid())
  costAnalysisId  String
  costAnalysis    CostAnalysis @relation(fields: [costAnalysisId], references: [id], onDelete: Cascade)

  // Operasyon bilgileri
  operationCode   String?
  operationName   String
  workCenter      String?
  laborType       CostLaborType @default(INTERNAL)

  // Süreler (saat)
  setupTime       Decimal  @default(0) @db.Decimal(6, 2)
  processTime     Decimal  @db.Decimal(6, 2)
  totalTime       Decimal  @db.Decimal(6, 2)  // Hesaplanan

  // Ücret
  hourlyRate      Decimal  @db.Decimal(8, 2)
  totalCost       Decimal  @db.Decimal(12, 2)  // Hesaplanan

  // Makine ilişkisi
  machineId       String?
  machine         CostMachine? @relation(fields: [machineId], references: [id])

  // Sıralama
  sortOrder       Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([costAnalysisId])
  @@index([machineId])
}

enum CostLaborType {
  INTERNAL    // Dahili
  EXTERNAL    // Dış hizmet
  ASSEMBLY    // Montaj
}

// Dış Hizmet: CostExternalService
model CostExternalService {
  id              String   @id @default(cuid())
  costAnalysisId  String
  costAnalysis    CostAnalysis @relation(fields: [costAnalysisId], references: [id], onDelete: Cascade)

  // Hizmet bilgileri
  serviceCode     String?
  serviceName     String
  description     String?  @db.Text
  serviceType     CostServiceType @default(PROCESSING)

  // Miktar ve fiyat
  quantity        Decimal  @default(1) @db.Decimal(10, 2)
  unit            String   @default("adet")
  unitPrice       Decimal  @db.Decimal(12, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)  // Hesaplanan

  // Tedarikçi
  supplierId      String?
  supplier        CostSupplier? @relation(fields: [supplierId], references: [id])

  // Sıralama
  sortOrder       Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([costAnalysisId])
  @@index([supplierId])
}

enum CostServiceType {
  PROCESSING        // İşleme (ısıl işlem, vb.)
  SURFACE_TREATMENT // Yüzey işleme (boya, kaplama)
  TESTING           // Test (NDT, vb.)
  CERTIFICATION     // Sertifikasyon
  TRANSPORT         // Nakliye
  OTHER             // Diğer
}

// Diğer Maliyetler: CostOtherItem
model CostOtherItem {
  id              String   @id @default(cuid())
  costAnalysisId  String
  costAnalysis    CostAnalysis @relation(fields: [costAnalysisId], references: [id], onDelete: Cascade)

  // Kalem bilgileri
  name            String
  description     String?  @db.Text
  category        OtherCostCategory

  // Miktar ve fiyat
  quantity        Decimal  @default(1) @db.Decimal(10, 2)
  unit            String   @default("adet")
  unitPrice       Decimal  @db.Decimal(12, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)  // Hesaplanan

  // Sıralama
  sortOrder       Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([costAnalysisId])
}

enum OtherCostCategory {
  ASSEMBLY_LABOR      // Montaj işçiliği
  CONNECTION_PARTS    // Bağlantı elemanları
  QUALITY_CONTROL     // Kalite kontrol
  TRANSPORT           // Nakliye
  PACKAGING           // Paketleme
  ENGINEERING         // Mühendislik
  TOOLING             // Takım/kalıp
  CERTIFICATION       // Sertifikasyon
  OTHER               // Diğer
}

// Ayar Tabloları

// Maliyet Kategorisi
model CostCategory {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  color       String   @default("#6366f1")  // Tailwind renk kodu
  description String?  @db.Text
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analyses    CostAnalysis[]

  @@index([isActive, sortOrder])
}

// Maliyet Müşterisi
model CostCustomer {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  country     String?
  contact     String?
  email       String?
  phone       String?
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analyses    CostAnalysis[]

  @@index([isActive])
}

// Maliyet Tedarikçisi
model CostSupplier {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  type        CostSupplierType @default(MATERIAL)
  country     String?
  contact     String?
  email       String?
  phone       String?
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materials         CostMaterial[]
  catalogMaterials  CostMaterialCatalog[]
  services          CostExternalService[]

  @@index([isActive])
  @@index([type])
}

enum CostSupplierType {
  MATERIAL    // Malzeme tedarikçisi
  SERVICE     // Hizmet tedarikçisi
  BOTH        // Her ikisi
}

// Maliyet Makinesi / İş Merkezi
model CostMachine {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  type        String?              // CNC, Lazer, Kaynak, vb.
  hourlyRate  Decimal  @db.Decimal(8, 2)
  description String?  @db.Text
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  laborItems  CostLabor[]

  @@index([isActive])
}

// Döviz Kuru
model CostExchangeRate {
  id            String   @id @default(cuid())
  fromCurrency  CostCurrency
  toCurrency    CostCurrency
  rate          Decimal  @db.Decimal(10, 4)
  effectiveDate DateTime @default(now())

  createdAt     DateTime @default(now())

  @@unique([fromCurrency, toCurrency, effectiveDate])
  @@index([effectiveDate])
}

// Maliyet Analizi Versiyonu (Geçmiş)
model CostAnalysisVersion {
  id              String   @id @default(cuid())
  costAnalysisId  String
  costAnalysis    CostAnalysis @relation(fields: [costAnalysisId], references: [id], onDelete: Cascade)

  version         Int
  snapshot        Json     // Tüm verilerin JSON snapshot'ı
  reason          String?  @db.Text // Değişiklik nedeni

  createdById     String
  createdAt       DateTime @default(now())

  @@index([costAnalysisId])
  @@index([createdAt])
}

// ==================== SSS / Bilgi Bankası ====================

// SSS Kategorisi
model FAQCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  icon        String?  // Lucide icon adı
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  faqs        FAQ[]

  @@index([isActive, sortOrder])
}

// Sıkça Sorulan Sorular
model FAQ {
  id              String   @id @default(cuid())
  question        String   @db.Text
  answer          String   @db.Text // Rich text (HTML)
  tags            String[] @default([])
  sortOrder       Int      @default(0)
  isPublished     Boolean  @default(false)
  viewCount       Int      @default(0)
  helpfulCount    Int      @default(0)
  notHelpfulCount Int      @default(0)

  categoryId      String
  category        FAQCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  authorId        String
  author          User @relation("FAQAuthor", fields: [authorId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  feedbacks       FAQFeedback[]

  @@index([categoryId, isPublished, sortOrder])
  @@index([isPublished, viewCount])
  @@index([isPublished, helpfulCount])
}

// SSS Geri Bildirim (Kullanıcı başına tek oy)
model FAQFeedback {
  id        String   @id @default(cuid())
  faqId     String
  faq       FAQ      @relation(fields: [faqId], references: [id], onDelete: Cascade)

  userId    String?  // Anonim kullanıcılar için null
  ipHash    String?  // Anonim kullanıcılar için IP hash
  helpful   Boolean  // true = faydalı, false = faydalı değil

  createdAt DateTime @default(now())

  @@unique([faqId, userId])
  @@unique([faqId, ipHash])
  @@index([faqId])
}
